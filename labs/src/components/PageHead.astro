---
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
---
<header class="wrap pt-16 pb-14 md:pt-24 md:pb-20">
  <h1 class="max-w-[18ch] text-[clamp(2.5rem,1.5rem+4.4vw,5.25rem)] leading-[1] tracking-[-0.032em] font-[440]">{title}</h1>
  {lead && <p class="mt-8 max-w-[52ch] text-lead text-slate">{lead}</p>}
  <slot />
</header>
