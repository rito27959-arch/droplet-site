---
import Rise from './Rise.astro';
interface Props { title: string; lead?: string; accent?: string }
const { title, lead, accent = 'var(--color-current)' } = Astro.props;
---
<header class="relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(90%_70%_at_80%_0%,var(--color-deep)_0%,var(--color-deeper)_40%,transparent_75%)]"></div>
  <div class="glow -z-10 right-[-8%] top-[-30%] h-[34rem] w-[34rem] opacity-35" style={`background:${accent}`}></div>
  <div class="wrap pt-40 pb-16 md:pt-52 md:pb-24">
    <Rise as="h1" text={title} class="max-w-[16ch] text-mega font-[500]" />
    {lead && <p class="mt-10 max-w-[50ch] text-lead text-haze" data-reveal style="--d:350ms">{lead}</p>}
    <slot />
  </div>
</header>
