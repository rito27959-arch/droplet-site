---
import { Menu, X, Sun, Moon } from '@lucide/astro';
import Logo from './Logo.astro';
import { cleanPath, t, href, switchHref, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const path = cleanPath(Astro.url.pathname);
const bare = path.replace(/^\/fr(?=\/|$)/, '') || '/';
const links = [
  { to: '/products', label: d.nav.products },
  { to: '/innovation', label: d.nav.innovation },
  { to: '/vision', label: d.nav.vision },
  { to: '/about', label: d.nav.about },
  { to: '/founder', label: d.nav.founder },
  { to: '/contact', label: d.nav.contact },
];
const isHere = (to: string) => bare === to || bare.startsWith(to + '/');
const other = lang === 'en' ? 'fr' : 'en';
---

<!-- A floating capsule of glass: the page shows through it. -->
<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 md:px-5 md:pt-4">
  <div class="mx-auto flex h-14 max-w-[80rem] items-center justify-between gap-4 rounded-full bg-abyss/55 pl-4 pr-2 shadow-[inset_0_0_0_1px_rgba(var(--rgb-foam),0.09),0_20px_60px_-30px_rgba(var(--rgb-abyss),0.8)] backdrop-blur-xl backdrop-saturate-150 md:pl-5">
    <a href={href(lang, '/')} class="flex items-center gap-2.5" aria-label={d.nav.home}>
      <Logo class="size-7 text-ice" />
      <span class="text-[1.02rem] font-[620] tracking-[-0.01em]">Droplet Labs</span>
    </a>

    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center gap-1 text-[0.93rem]">
        {links.map((l) => (
          <li>
            <a href={href(lang, l.to)}
               class:list={['rounded-full px-3.5 py-2 transition-colors', isHere(l.to) ? 'bg-foam/10 text-foam' : 'text-haze hover:text-foam']}
               aria-current={isHere(l.to) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <a href={switchHref(lang, path)} hreflang={other} lang={other} data-astro-reload
         class="hidden sm:inline-flex h-10 items-center rounded-full px-4 text-[0.9rem] text-haze hover:text-foam">{d.otherLang}</a>
      <button type="button" data-theme-toggle class="inline-flex size-10 items-center justify-center rounded-full text-haze hover:bg-foam/10 hover:text-foam" aria-pressed="false">
        <Sun class="theme-sun size-[1.15rem]" aria-hidden="true" />
        <Moon class="theme-moon size-[1.15rem]" aria-hidden="true" />
        <span class="sr-only">{d.nav.theme}</span>
      </button>
      <a href={href(lang, '/contact')} class="hidden md:inline-flex btn btn-light !h-10 !px-4 !text-[0.9rem]">{d.nav.contact}</a>
      <button id="menu-open" type="button" class="lg:hidden inline-flex size-10 items-center justify-center rounded-full hover:bg-foam/10"
              aria-controls="menu-panel" aria-expanded="false">
        <Menu class="size-5" aria-hidden="true" />
        <span class="sr-only">{d.nav.menu}</span>
      </button>
    </div>
  </div>

  <div id="menu-panel" data-open="false" class="lg:hidden fixed inset-0 z-50 bg-abyss/95 backdrop-blur-2xl" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="flex h-[4.25rem] items-center justify-between px-6 pt-3">
      <a href={href(lang, '/')} class="flex items-center gap-2.5" aria-label={d.nav.home}>
        <Logo class="size-7 text-ice" /><span class="font-[620]">Droplet Labs</span>
      </a>
      <button id="menu-close" type="button" class="inline-flex size-10 items-center justify-center rounded-full hover:bg-foam/10">
        <X class="size-5" aria-hidden="true" /><span class="sr-only">{d.nav.close}</span>
      </button>
    </div>
    <nav class="px-6 pt-8" aria-label="Main">
      <ul>
        {links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={href(lang, l.to)} class:list={['block py-2.5 text-[2.4rem] leading-tight tracking-[-0.035em]', isHere(l.to) ? 'text-ice' : 'text-foam']}
               aria-current={isHere(l.to) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
        <li style={`--i:${links.length}`} class="pt-8">
          <a href={switchHref(lang, path)} hreflang={other} lang={other} data-astro-reload class="btn btn-glass">{d.otherLang}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function menu() {
    const panel = document.getElementById('menu-panel');
    const open = document.getElementById('menu-open');
    const close = document.getElementById('menu-close');
    if (!panel || !open || !close || panel.dataset.ready) return;
    panel.dataset.ready = '1';
    const set = (on: boolean) => {
      panel.dataset.open = String(on);
      open.setAttribute('aria-expanded', String(on));
      document.documentElement.style.overflow = on ? 'hidden' : '';
      (on ? close : open).focus();
    };
    open.addEventListener('click', () => set(true));
    close.addEventListener('click', () => set(false));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel.dataset.open === 'true') set(false); });
  }
  document.addEventListener('astro:page-load', menu);

  // Light or dark: the choice stays in this browser (see the privacy page).
  function theme() {
    const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!btn) return;
    const sync = () => btn.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'light'));
    sync();
    btn.onclick = () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      try { localStorage.setItem('theme', next); } catch {}
      if (next === 'light') document.documentElement.dataset.theme = 'light'; else delete document.documentElement.dataset.theme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#eef5f7' : '#03111a');
      sync();
    };
  }
  document.addEventListener('astro:page-load', theme);
</script>
