---
// A phone in three dimensions, holding the app's real screen. Pure CSS 3D:
// a front, a back, and thin slices of the frame in between give it depth.
// It turns once when it comes into view, then follows the scroll and the
// pointer. With reduced motion, it simply stands at an angle.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { screen: ImageMetadata; alt: string; accent: string; name: string; class?: string }
const { screen, alt, accent, name, class: cls } = Astro.props;
const slices = Array.from({ length: 18 }, (_, i) => i);
---
<div class:list={['p3', cls]} data-phone3d style={`--accent:${accent}`}>
  <div class="p3-glow" aria-hidden="true"></div>
  <div class="p3-body">
    {slices.map((i) => <i class="p3-slice" style={`--z:${i}`} aria-hidden="true"></i>)}
    <div class="p3-back" aria-hidden="true">
      <span class="p3-cam"><i></i><i></i><i></i></span>
      <span class="p3-name">{name}</span>
    </div>
    <div class="p3-front">
      <Image src={screen} alt={alt} widths={[320, 640, 900]} sizes="(min-width: 64rem) 20rem, 64vw" class="p3-screen" loading="lazy" />
      <span class="p3-glare" aria-hidden="true"></span>
    </div>
  </div>
  <div class="p3-shadow" aria-hidden="true"></div>
</div>

<style>
  .p3 { --w: min(19rem, 64vw); --t: 11px; --r: calc(var(--w) * 0.15); --ry: -18deg; --rx: 6deg; --spin: 0deg;
    position: relative; width: var(--w); aspect-ratio: 0.46; margin-inline: auto; perspective: 1600px; }
  .p3-body { position: absolute; inset: 0; transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(calc(var(--ry) + var(--spin))); }
  .p3-body > * { position: absolute; inset: 0; border-radius: var(--r); backface-visibility: hidden; }
  .p3-slice { backface-visibility: visible !important; background: linear-gradient(90deg, #2a3138, #6d7780 30%, #3a4148 60%, #8a949c);
    transform: translateZ(calc(var(--t) * -1 * var(--z) / 17)); }
  .p3-front { transform: translateZ(1px); background: #050607; padding: calc(var(--w) * 0.032);
    box-shadow: inset 0 0 0 1.5px #4a535b; }
  .p3-screen { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: calc(var(--r) * 0.82); }
  .p3-glare { position: absolute; inset: 0 !important; border-radius: var(--r); pointer-events: none;
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.16) 45%, transparent 58%);
    background-size: 260% 100%; background-position: calc(50% + var(--gl, 0) * 1%) 0; mix-blend-mode: screen; }
  .p3-back { transform: translateZ(calc(var(--t) * -1 - 1px)) rotateY(180deg);
    background: radial-gradient(120% 80% at 30% 10%, color-mix(in oklab, var(--accent) 55%, #1b2228), #12171c 75%);
    box-shadow: inset 0 0 0 1.5px #4a535b; }
  .p3-cam { position: absolute; left: 8%; top: 4%; width: 38%; aspect-ratio: 1; border-radius: 28%; background: rgb(0 0 0 / 0.35);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12); }
  .p3-cam i { position: absolute; width: 36%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #3b4a57, #050607 60%);
    box-shadow: 0 0 0 2px #2b3239; }
  .p3-cam i:nth-child(1) { left: 9%; top: 9%; } .p3-cam i:nth-child(2) { left: 9%; bottom: 9%; } .p3-cam i:nth-child(3) { right: 9%; top: 32%; }
  .p3-name { position: absolute; inset: auto 0 12% 0; text-align: center; color: rgb(255 255 255 / 0.7); font-weight: 560; letter-spacing: -0.01em; }
  .p3-shadow { position: absolute; left: 12%; right: 12%; bottom: -9%; height: 8%; border-radius: 50%; background: rgba(var(--rgb-abyss), 1);
    filter: blur(18px); opacity: 0.55; transform: scaleX(calc(1 - var(--tilt, 0) * 0.2)); }
  :global(:root[data-theme='light']) .p3-shadow { background: #0a2a38; opacity: 0.25; }
  .p3-glow { position: absolute; inset: 10% -20%; border-radius: 50%; background: var(--accent); filter: blur(80px); opacity: 0.35; }
  .p3.spin .p3-body { transition: none; }
  @media (prefers-reduced-motion: reduce) { .p3 { --spin: 0deg !important; } }
</style>

<script>
  function phones() {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-phone3d]').forEach((el) => {
      if (el.dataset.ready) return;
      el.dataset.ready = '1';
      if (calm) return;
      let px = 0, py = 0, tx = 0, ty = 0, spin = 0, spinFrom = 0, raf = 0, visible = false;
      const ease = (k: number) => 1 - Math.pow(1 - k, 4);
      const tick = (now: number) => {
        raf = 0;
        const r = el.getBoundingClientRect();
        // Scroll: from -28° entering at the bottom to +16° leaving at the top.
        const k = Math.max(0, Math.min(1, (innerHeight - r.top) / (innerHeight + r.height)));
        const base = -28 + k * 44;
        px += (tx - px) * 0.08; py += (ty - py) * 0.08;
        if (spinFrom) { const s = Math.min(1, (now - spinFrom) / 1800); spin = 360 * (1 - ease(s)); if (s >= 1) spinFrom = 0, spin = 0; }
        el.style.setProperty('--ry', `${(base + px * 16).toFixed(2)}deg`);
        el.style.setProperty('--rx', `${(6 - py * 8).toFixed(2)}deg`);
        el.style.setProperty('--spin', `${spin.toFixed(2)}deg`);
        el.style.setProperty('--gl', `${((base + px * 16) * 1.6).toFixed(1)}`);
        el.style.setProperty('--tilt', `${Math.abs(base / 40).toFixed(3)}`);
        if (visible) raf = requestAnimationFrame(tick);
      };
      let turned = false;
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible && !turned && e.intersectionRatio > 0.35) { turned = true; spinFrom = performance.now(); }
        if (visible && !raf) raf = requestAnimationFrame(tick);
      }, { threshold: [0, 0.35] }).observe(el);
      el.addEventListener('pointermove', (ev) => {
        const r = el.getBoundingClientRect();
        tx = ((ev.clientX - r.left) / r.width - 0.5) * 2; ty = ((ev.clientY - r.top) / r.height - 0.5) * 2;
      });
      el.addEventListener('pointerleave', () => { tx = 0; ty = 0; });
    });
  }
  document.addEventListener('astro:page-load', phones);
</script>
