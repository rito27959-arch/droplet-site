---
// L'écran réel de l'app, posé à plat (Droplet Design Language : un écran,
// pas un téléphone dessiné, et aucun mouvement qui n'explique rien).
// Le nom du composant est gardé pour ne pas toucher aux pages qui l'emploient.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { screen: ImageMetadata; alt: string; accent: string; name: string; class?: string }
const { screen, alt, class: cls } = Astro.props;
---
<figure class:list={['ecran', cls]}>
  <Image src={screen} alt={alt} widths={[320, 640, 900]} sizes="(min-width: 64rem) 20rem, 64vw" loading="lazy" />
</figure>

<style>
  .ecran {
    margin: 0 auto;
    width: min(19rem, 64vw);
    border-radius: 2.25rem;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-foam) 12%, transparent);
    background: var(--color-trench);
  }
  .ecran :global(img) {
    width: 100%;
    height: auto;
  }
</style>
