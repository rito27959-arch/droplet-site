---
// A headline whose words rise out of the water one after another.
// The words stay real text: selectable, read by screen readers, indexed.
interface Props { text: string; as?: 'h1' | 'h2' | 'h3' | 'p'; class?: string; delay?: number }
const { text, as: Tag = 'h2', class: cls = '', delay = 0 } = Astro.props;
const words = text.split(' ');
---
<Tag class={`rise ${cls}`} style={`--d:${delay}ms`} data-rise aria-label={text}>
  {words.map((w, i) => (
    <>
      <span class="line" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{i < words.length - 1 ? ' ' : ''}
    </>
  ))}
</Tag>
