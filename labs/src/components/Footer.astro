---
import Logo from './Logo.astro';
import Finale from './Finale.astro';
import { t, href, type Lang } from '../i18n';
import { site, social, contact } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
---

<footer class="relative isolate mt-auto overflow-hidden border-t border-foam/[0.08]">
  <div class="glow -z-10 bottom-[-40%] left-1/2 h-[30rem] w-[60rem] -translate-x-1/2 bg-current/25"></div>
  <div class="wrap grid gap-14 pt-20 pb-10 md:grid-cols-12 md:pt-28">
    <div class="md:col-span-6">
      <p class="max-w-[16ch] text-[clamp(2rem,1.3rem+2.6vw,3.6rem)] leading-[1.02] tracking-[-0.04em] font-[480]">{d.footer.tagline}</p>
      <p class="mt-8 max-w-[44ch] text-[0.92rem] text-haze">{d.status}</p>
    </div>
    <nav class="md:col-span-3" aria-label="Footer">
      <ul class="space-y-3 text-[0.97rem]">
        <li><a class="text-haze hover:text-foam" href={href(lang, '/products')}>{d.nav.products}</a></li>
        <li><a class="text-haze hover:text-foam" href={href(lang, '/innovation')}>{d.nav.innovation}</a></li>
        <li><a class="text-haze hover:text-foam" href={href(lang, '/vision')}>{d.nav.vision}</a></li>
        <li><a class="text-haze hover:text-foam" href={href(lang, '/about')}>{d.nav.about}</a></li>
        <li><a class="text-haze hover:text-foam" href={href(lang, '/founder')}>{d.nav.founder}</a></li>
        <li><a class="text-haze hover:text-foam" href={href(lang, '/contact')}>{d.nav.contact}</a></li>
      </ul>
    </nav>
    <div class="md:col-span-3 space-y-3 text-[0.97rem] [overflow-wrap:anywhere]">
      <p>{site.city}, {lang === 'fr' ? 'Cameroun' : site.country}</p>
      <p class="text-haze">{site.coordinates.lat}, {site.coordinates.lon}</p>
      {contact.general && <p><a class="link" href={`mailto:${contact.general}`}>{contact.general}</a></p>}
      {social.map((s) => <p><a class="link" href={s.url} rel="me noopener">{s.label}</a></p>)}
    </div>
  </div>
  <!-- The name, made of the mesh: the points gather as the page ends. -->
  <div class="wrap pb-4 pt-6">
    <Finale />
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-4 border-t border-foam/[0.08] py-6 text-[0.85rem] text-haze">
    <a href={href(lang, '/')} class="flex items-center gap-2" aria-label={d.nav.home}><Logo class="size-5 text-ice" /> © 2026 {d.footer.rights}</a>
    <nav class="flex gap-6" aria-label={d.nav.legal}>
      <a class="hover:text-foam" href={href(lang, '/legal')}>{d.nav.legal}</a>
      <a class="hover:text-foam" href={href(lang, '/privacy')}>{d.nav.privacy}</a>
    </nav>
  </div>
</footer>
