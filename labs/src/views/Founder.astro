---
import Base from '../layouts/Base.astro';
import Rise from '../components/Rise.astro';
import Portrait from '../components/Portrait.astro';
import { products } from '../products';
import { t, href, type Lang } from '../i18n';
import { founder, site } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const f = d.founder;
const h = d.home;
const jsonLd = founder.name
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: founder.name,
      jobTitle: d.roleTitle,
      address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'CM' },
    }
  : undefined;
---
<Base lang={lang} title={founder.name ?? f.title} description={f.description} jsonLd={jsonLd}>
  <!-- A portrait lit from above, in deep water. -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(70%_60%_at_30%_10%,#0f4356_0%,#06202d_45%,#03111a_80%)]"></div>
    <div class="glow -z-10 left-[10%] top-[10%] h-[36rem] w-[36rem] bg-current/40"></div>
    <div class="wrap grid gap-12 pt-32 pb-20 md:grid-cols-12 md:items-end md:gap-10 md:pt-44 md:pb-28">
      <div class="md:col-span-5" data-lift>
        <div class="relative">
          <Portrait lang={lang} eager sizes="(min-width: 48rem) 40vw, 100vw" class="!rounded-[44px]" />
          <div class="pointer-events-none absolute inset-0 rounded-[44px] ring-1 ring-inset ring-foam/15"></div>
          <div class="pointer-events-none absolute inset-0 rounded-[44px] bg-[linear-gradient(180deg,transparent_55%,rgba(3,17,26,0.55))]"></div>
        </div>
      </div>
      <div class="md:col-span-7 md:pl-6">
        <p class="text-[0.95rem] text-ice" data-reveal>{d.roleTitle}</p>
        <Rise as="h1" text={founder.name ?? d.TheFounder} class="mt-5 text-hero font-[500] max-w-[10ch]" />
        <p class="mt-10 max-w-[38ch] text-[clamp(1.3rem,1.05rem+1vw,1.9rem)] leading-[1.35] tracking-[-0.015em]" data-reveal style="--d:300ms">{h.founderText}</p>
        <p class="mt-8 text-haze" data-reveal style="--d:400ms">{site.city}, {lang === 'fr' ? 'Cameroun' : site.country}</p>
      </div>
    </div>
  </section>

  <section class="wrap grid gap-8 border-t border-foam/[0.08] py-20 md:grid-cols-12 md:gap-10 md:py-28">
    <h2 class="md:col-span-4 text-[0.95rem] text-haze" data-reveal>{f.bioTitle}</h2>
    <div class="md:col-span-8 space-y-8 text-[clamp(1.25rem,1.05rem+0.8vw,1.75rem)] leading-[1.45] tracking-[-0.012em] max-w-[44ch]">
      {f.bio.map((p, i) => <p data-reveal style={`--d:${i * 100}ms`}>{p}</p>)}
    </div>
  </section>

  <!-- His own question, the one that started everything. -->
  <section class="relative isolate overflow-hidden border-t border-foam/[0.08]">
    <div class="glow -z-10 left-1/2 top-1/2 h-[30rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 bg-current/25"></div>
    <figure class="wrap py-24 md:py-36">
      <blockquote>
        <Rise as="p" text={`« ${f.quote} »`.replace('« ', lang === 'fr' ? '« ' : '“').replace(' »', lang === 'fr' ? ' »' : '”')} class="max-w-[24ch] text-[clamp(2rem,1.2rem+3.4vw,4.6rem)] leading-[1.05] tracking-[-0.04em] font-[480]" />
      </blockquote>
      <figcaption class="mt-10 text-haze" data-reveal style="--d:400ms">{f.quoteBy}</figcaption>
    </figure>
  </section>

  <!-- His path, from the neighbourhood to the company. -->
  <section class="wrap grid gap-8 border-t border-foam/[0.08] py-20 md:grid-cols-12 md:gap-10 md:py-28">
    <h2 class="md:col-span-4 text-[0.95rem] text-haze" data-reveal>{f.pathTitle}</h2>
    <ol class="md:col-span-8">
      {f.path.map((e, i) => (
        <li class="grid gap-2 border-t border-foam/[0.08] py-7 sm:grid-cols-[11rem_1fr] sm:gap-8" data-reveal style={`--d:${i * 90}ms`}>
          <p class:list={['text-lead', i === f.path.length - 1 ? 'text-ice' : 'text-haze']}>{e.when}</p>
          <p class="max-w-[44ch] text-lead">{e.what}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Real dates, from the first commit of each project. -->
  <section class="border-t border-foam/[0.08] bg-trench/60">
    <div class="wrap py-20 md:py-28">
      <Rise text={h.timelineTitle} class="text-title" />
      <ol class="relative mt-16 grid gap-10 md:grid-cols-5 md:gap-6">
        <span class="absolute left-[5px] top-0 h-full w-px bg-foam/15 md:left-0 md:top-[5px] md:h-px md:w-full" aria-hidden="true"></span>
        {h.timeline.map((e, i) => (
          <li class="relative pl-8 md:pl-0 md:pt-10" data-reveal style={`--d:${i * 110}ms`}>
            <span class:list={['absolute left-0 top-[0.45rem] size-[11px] rounded-full md:top-0', i === h.timeline.length - 1 ? 'bg-ice shadow-[0_0_18px_#8eeaf5]' : 'bg-foam/50']} aria-hidden="true"></span>
            <p class="text-[0.92rem] text-haze">{e.when}</p>
            <p class="mt-2 max-w-[26ch]">{e.what}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap grid gap-8 border-t border-foam/[0.08] py-20 md:grid-cols-12 md:gap-10 md:py-28">
    <h2 class="md:col-span-4 text-[0.95rem] text-haze" data-reveal>{f.philosophyTitle}</h2>
    <ol class="md:col-span-8 space-y-10">
      {f.philosophy.map((p, i) => (
        <li class="grid grid-cols-[3rem_1fr] items-baseline gap-4" data-reveal style={`--d:${i * 100}ms`}>
          <span class="text-[1.4rem] text-ice tabular-nums">{i + 1}</span>
          <span class="max-w-[38ch] text-[clamp(1.3rem,1.05rem+1vw,1.9rem)] leading-[1.3] tracking-[-0.02em]">{p}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap grid gap-8 border-t border-foam/[0.08] py-20 md:grid-cols-12 md:gap-10 md:py-28">
    <h2 class="md:col-span-4 text-[0.95rem] text-haze" data-reveal>{f.projectsTitle}</h2>
    <ul class="md:col-span-8 border-b border-foam/[0.08]">
      {products.map((p, i) => (
        <li class="border-t border-foam/[0.08]" data-reveal style={`--d:${i * 60}ms`}>
          <a class="group flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-6" href={href(lang, `/products/${p.slug}`)}>
            <span class="flex items-center gap-3 text-[1.6rem] tracking-[-0.025em] transition-transform duration-500 group-hover:translate-x-2">
              <span class="size-2 rounded-full" style={`background:${p.accent};box-shadow:0 0 14px ${p.accent}`}></span>{p.name}
            </span>
            <span class="text-[0.92rem] text-haze">{p.stage[lang]}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="relative isolate overflow-hidden border-t border-foam/[0.08]">
    <div class="glow -z-10 right-[10%] top-[10%] h-[30rem] w-[30rem] bg-current/30"></div>
    <div class="wrap py-24 md:py-36">
      <h2 class="text-[0.95rem] text-haze" data-reveal>{f.ambitionsTitle}</h2>
      <Rise as="p" text={f.ambitions} class="mt-8 max-w-[22ch] text-[clamp(2rem,1.2rem+3.2vw,4.4rem)] leading-[1.05] tracking-[-0.04em] font-[480]" />
    </div>
  </section>
</Base>
