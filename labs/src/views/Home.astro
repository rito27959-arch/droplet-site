---
import Base from '../layouts/Base.astro';
import MeshCanvas from '../components/MeshCanvas.astro';
import LiquidDrop from '../components/LiquidDrop.astro';
import Story from '../components/Story.astro';
import Rise from '../components/Rise.astro';
import ProductMedia from '../components/ProductMedia.astro';
import Portrait from '../components/Portrait.astro';
import { products } from '../products';
import { t, href, type Lang } from '../i18n';
import { site, contact, founder } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const h = d.home;
const country = lang === 'fr' ? 'Cameroun' : site.country;
---
<Base lang={lang} title={h.title} description={h.description}>
  <!-- ── Hero: the mesh, alive ─────────────────────────────────────── -->
  <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(120%_80%_at_70%_0%,#0d3a4c_0%,#06202d_38%,#03111a_75%)]"></div>
    <div class="glow -z-10 left-[55%] top-[-10%] h-[38rem] w-[38rem] bg-current/40"></div>
    <MeshCanvas />
    <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-0 h-[40%] bg-gradient-to-t from-abyss to-transparent"></div>

    <!-- The drop: centre stage on phones, to the right of the headline on large screens. -->
    <div class="pointer-events-none absolute left-1/2 top-[4.75rem] size-[min(62vw,22rem)] -translate-x-1/2 md:left-auto md:right-[2%] md:top-[12%] md:size-[min(46vw,40rem)] md:translate-x-0" data-reveal style="--d:250ms">
      <LiquidDrop class="h-full w-full" />
    </div>
    <div class="wrap relative pb-14 pt-[calc(5rem+min(62vw,22rem))] md:pb-20 md:pt-36">
      <p class="mb-8 inline-flex items-center gap-2.5 rounded-full bg-foam/[0.06] py-1.5 pl-2 pr-4 text-[0.88rem] text-haze ring-1 ring-foam/10 backdrop-blur" data-reveal>
        <span class="relative flex size-2.5"><span class="absolute inset-0 animate-ping rounded-full bg-ice/60 motion-reduce:animate-none"></span><span class="relative size-2.5 rounded-full bg-ice"></span></span>
        {site.city}, {country}
      </p>
      <Rise as="h1" text={h.headline} class="relative max-w-[12ch] text-hero font-[500] [text-shadow:0_2px_40px_rgba(3,17,26,0.6)]" />
      <div class="mt-10 grid gap-10 md:mt-14 md:grid-cols-12 md:items-end">
        <p class="md:col-span-6 max-w-[46ch] text-lead text-haze" data-reveal style="--d:500ms">{h.lead}</p>
        <div class="md:col-span-6 flex flex-wrap gap-3 md:justify-end" data-reveal style="--d:650ms">
          <a class="btn btn-light" href={href(lang, '/products')} data-magnet>{h.ctaProducts}</a>
          <a class="btn btn-glass" href={href(lang, '/founder')} data-magnet>{h.ctaFounder}</a>
        </div>
      </div>
      <p class="mt-14 max-w-[52ch] border-t border-foam/10 pt-5 text-[0.88rem] text-haze/80" data-reveal style="--d:800ms">{d.status}</p>
    </div>
  </section>

  <!-- ── Manifesto: words light up as you read ─────────────────────── -->
  <section class="wrap py-28 md:py-44">
    <p class="lit-words max-w-[24ch] text-[clamp(1.9rem,1.1rem+3.4vw,4.4rem)] leading-[1.08] tracking-[-0.035em] font-[480]">
      {h.manifesto.split(' ').map((w) => <><span class="w">{w}</span>{' '}</>)}
    </p>
  </section>

  <!-- ── The story, pinned to the screen as you scroll ─────────────── -->
  <Story lang={lang} />

  <!-- ── The projects, one chapter each ────────────────────────────── -->
  <section aria-labelledby="projects-title" class="relative">
    <div class="wrap flex flex-wrap items-end justify-between gap-6 pb-16">
      <Rise text={h.productsTitle} class="text-mega" />
      <p class="max-w-[32ch] text-haze" data-reveal>{h.productsLead}</p>
    </div>
    <h2 id="projects-title" class="sr-only">{h.productsTitle}</h2>

    {products.map((p, i) => (
      <article class="relative isolate overflow-hidden border-t border-foam/[0.08] py-20 md:py-32" style={`--accent:${p.accent}`}>
        <div class:list={['glow -z-10 top-[10%] h-[30rem] w-[30rem] opacity-25', i % 2 ? 'left-[-10%]' : 'right-[-10%]']} style={`background:${p.accent}`}></div>
        <div class="wrap grid items-center gap-12 md:grid-cols-12 md:gap-10">
          <div class:list={['md:col-span-5', i % 2 ? 'md:order-2 md:col-start-8' : '']}>
            <p class="flex items-center gap-3 text-[0.92rem] text-haze" data-reveal>
              <span class="size-2 rounded-full" style={`background:${p.accent};box-shadow:0 0 18px ${p.accent}`}></span>
              {p.stage[lang]}
            </p>
            <Rise as="h3" text={p.name} class="mt-5 text-title" />
            <p class="mt-6 max-w-[40ch] text-lead text-haze" data-reveal>{p.line[lang]}</p>
            <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal style="--d:120ms">
              <a class="btn btn-glass" href={href(lang, `/products/${p.slug}`)} data-magnet>{h.discover} {p.name}</a>
              {p.website && <a class="link text-[0.95rem] text-haze hover:text-foam" href={p.website} rel="noopener">{new URL(p.website).host}</a>}
            </div>
          </div>
          <div class:list={['md:col-span-7', i % 2 ? 'md:order-1 md:col-start-1' : '']} data-lift>
            <ProductMedia slug={p.slug} lang={lang} />
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- ── Real numbers ──────────────────────────────────────────────── -->
  <section class="border-t border-foam/[0.08] bg-trench/60">
    <div class="wrap py-24 md:py-32">
      <Rise text={h.statsTitle} class="text-title max-w-[14ch]" />
      <dl class="mt-16 grid gap-px overflow-hidden rounded-[28px] bg-foam/[0.08] sm:grid-cols-2 lg:grid-cols-4">
        {h.stats.map((s, i) => (
          <div class="bg-abyss/90 p-8 md:p-10" data-reveal style={`--d:${i * 90}ms`}>
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class="block text-[clamp(3.2rem,2rem+3vw,5rem)] leading-none tracking-[-0.05em] font-[500] tabular-nums" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</span>
              <span class="mt-5 block max-w-[24ch] text-[0.95rem] text-haze">{s.label}</span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 text-[0.85rem] text-haze/70">{h.statsNote}</p>
    </div>
  </section>

  <!-- ── The founder ───────────────────────────────────────────────── -->
  <section class="relative isolate overflow-hidden border-t border-foam/[0.08]">
    <div class="glow -z-10 left-[5%] top-[20%] h-[34rem] w-[34rem] bg-current/30"></div>
    <div class="wrap grid gap-14 py-24 md:grid-cols-12 md:items-center md:gap-10 md:py-36">
      <div class="md:col-span-5" data-lift>
        <div class="relative">
          <Portrait lang={lang} sizes="(min-width: 48rem) 40vw, 100vw" class="!rounded-[40px]" />
          <div class="pointer-events-none absolute inset-0 rounded-[40px] ring-1 ring-inset ring-foam/15"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 rounded-b-[40px] bg-gradient-to-t from-abyss/80 to-transparent"></div>
          <p class="absolute bottom-6 left-6 right-6 text-[0.95rem]">{founder.name ?? d.TheFounder}<span class="block text-haze">{d.roleTitle}</span></p>
        </div>
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <Rise text={h.founderTitle} class="text-title" />
        <p class="mt-8 max-w-[42ch] text-[clamp(1.25rem,1.05rem+0.8vw,1.75rem)] leading-[1.4] tracking-[-0.015em]" data-reveal>{h.founderText}</p>

        <h3 class="mt-14 text-[0.95rem] text-haze" data-reveal>{h.timelineTitle}</h3>
        <ol class="relative mt-6 border-l border-foam/15 pl-7">
          {h.timeline.map((e, i) => (
            <li class="relative pb-6 last:pb-0" data-reveal style={`--d:${i * 80}ms`}>
              <span class:list={['absolute -left-[calc(1.75rem+5px)] top-[0.45rem] size-[9px] rounded-full', i === h.timeline.length - 1 ? 'bg-ice shadow-[0_0_16px_#8eeaf5]' : 'bg-foam/40']}></span>
              <p class="text-[0.9rem] text-haze">{e.when}</p>
              <p>{e.what}</p>
            </li>
          ))}
        </ol>
        <a class="btn btn-light mt-12" href={href(lang, '/founder')} data-magnet>{h.founderLink}</a>
      </div>
    </div>
  </section>

  <!-- ── Vision and contact ────────────────────────────────────────── -->
  <section class="border-t border-foam/[0.08]">
    <div class="wrap grid gap-20 py-24 md:grid-cols-2 md:gap-10 md:py-32">
      <div>
        <Rise text={h.visionTitle} class="text-title max-w-[12ch]" />
        <p class="mt-8 max-w-[42ch] text-lead text-haze" data-reveal>{h.visionText}</p>
        <a class="mt-8 inline-block link text-lead" href={href(lang, '/vision')} data-reveal>{h.visionLink}</a>
      </div>
      <div class="glass rounded-[32px] p-8 md:p-12" data-lift>
        <h2 class="text-title">{h.contactTitle}</h2>
        <p class="mt-6 max-w-[38ch] text-haze">{h.contactText}</p>
        {contact.general && (
          <a class="mt-10 block break-all text-[clamp(1.5rem,1rem+1.8vw,2.4rem)] tracking-[-0.025em] text-ice link" href={`mailto:${contact.general}`}>{contact.general}</a>
        )}
        <a class="mt-8 inline-block link text-haze hover:text-foam" href={href(lang, '/contact')}>{h.contactLink}</a>
      </div>
    </div>
  </section>

  <script>
    // Numbers count up once, when they come into view.
    function counters() {
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('[data-count]');
      if (calm) return;
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count), suffix = el.dataset.suffix ?? '';
        const t0 = performance.now(), dur = 1400;
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / dur), ease = 1 - Math.pow(1 - k, 4);
          el.textContent = Math.round(end * ease) + suffix;
          if (k < 1) requestAnimationFrame(step);
        };
        el.textContent = '0' + suffix;
        requestAnimationFrame(step);
      }), { threshold: 0.6 });
      els.forEach((el) => io.observe(el));
    }
    document.addEventListener('astro:page-load', counters);
  </script>
</Base>
