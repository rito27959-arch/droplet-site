---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Portrait from '../components/Portrait.astro';
import { t, href, type Lang } from '../i18n';
import { founder } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const a = d.about;
---
<Base lang={lang} title={a.title} description={a.description}>
  <PageHead title={a.headline} />

  <section class="wrap rule grid gap-6 py-16 md:grid-cols-12 md:gap-8 md:py-24">
    <h2 class="md:col-span-4 text-[1.05rem] font-[560] text-river">{a.originTitle}</h2>
    <div class="md:col-span-8 space-y-6 text-[clamp(1.15rem,1rem+0.6vw,1.45rem)] leading-[1.5] max-w-[54ch]">
      {a.origin.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="wrap rule grid gap-10 py-16 md:grid-cols-12 md:items-center md:gap-8 md:py-24">
    <div class="md:col-span-4">
      <Portrait lang={lang} sizes="(min-width: 48rem) 30vw, 100vw" />
    </div>
    <div class="md:col-span-7 md:col-start-6">
      <h2 class="text-title">{a.founderTitle}</h2>
      {founder.name && <p class="mt-4 text-lead">{founder.name}</p>}
      <p class="mt-6 max-w-[46ch] text-lead text-slate">{a.founder}</p>
      <a class="mt-8 inline-block link" href={href(lang, '/founder')}>{a.founderLink}</a>
    </div>
  </section>

  <section class="bg-foam">
    <div class="wrap grid gap-14 py-20 md:grid-cols-2 md:gap-8 md:py-28">
      <div class="md:pr-8">
        <h2 class="text-title">{a.motivationTitle}</h2>
        <p class="mt-6 max-w-[44ch] text-lead text-slate">{a.motivation}</p>
      </div>
      <div class="md:border-l md:border-ink/12 md:pl-8">
        <h2 class="text-title">{a.philosophyTitle}</h2>
        <ul class="mt-6 space-y-5">
          {a.philosophy.map((p) => <li class="max-w-[46ch] border-l-2 border-river pl-5">{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap grid gap-6 py-20 md:grid-cols-12 md:gap-8 md:py-28">
    <h2 class="md:col-span-4 text-[1.05rem] font-[560] text-river">{a.ambitionsTitle}</h2>
    <div class="md:col-span-8">
      <p class="text-[clamp(1.25rem,1.05rem+0.8vw,1.7rem)] leading-[1.4] tracking-[-0.01em] max-w-[50ch]">{a.ambitions}</p>
      <a class="mt-8 inline-block link" href={href(lang, '/vision')}>{a.visionLink}</a>
    </div>
  </section>
</Base>
