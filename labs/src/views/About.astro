---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Rise from '../components/Rise.astro';
import Portrait from '../components/Portrait.astro';
import { t, href, type Lang } from '../i18n';
import { founder } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const a = d.about;
---
<Base lang={lang} title={a.title} description={a.description}>
  <PageHead title={a.headline} />

  <section class="wrap grid gap-8 border-t border-foam/[0.08] py-20 md:grid-cols-12 md:gap-10 md:py-28">
    <h2 class="md:col-span-4 text-[0.95rem] text-haze" data-reveal>{a.originTitle}</h2>
    <div class="md:col-span-8 space-y-8 text-[clamp(1.3rem,1.05rem+1vw,1.9rem)] leading-[1.4] tracking-[-0.015em] max-w-[42ch]">
      {a.origin.map((p, i) => <p data-reveal style={`--d:${i * 100}ms`}>{p}</p>)}
    </div>
  </section>

  <section class="relative isolate overflow-hidden border-t border-foam/[0.08]">
    <div class="glow -z-10 left-0 top-1/4 h-[28rem] w-[28rem] bg-current/30"></div>
    <div class="wrap grid gap-12 py-20 md:grid-cols-12 md:items-center md:gap-10 md:py-28">
      <div class="md:col-span-4" data-lift><Portrait lang={lang} sizes="(min-width: 48rem) 30vw, 100vw" class="!rounded-[36px]" /></div>
      <div class="md:col-span-7 md:col-start-6">
        <Rise text={a.founderTitle} class="text-title" />
        {founder.name && <p class="mt-4 text-lead">{founder.name}</p>}
        <p class="mt-8 max-w-[44ch] text-lead text-haze" data-reveal>{a.founder}</p>
        <a class="btn btn-glass mt-10" href={href(lang, '/founder')} data-magnet>{a.founderLink}</a>
      </div>
    </div>
  </section>

  <section class="border-t border-foam/[0.08] bg-trench/60">
    <div class="wrap grid gap-16 py-20 md:grid-cols-2 md:gap-10 md:py-28">
      <div>
        <Rise text={a.motivationTitle} class="text-title" />
        <p class="mt-8 max-w-[42ch] text-lead text-haze" data-reveal>{a.motivation}</p>
      </div>
      <div>
        <Rise text={a.philosophyTitle} class="text-title max-w-[14ch]" />
        <ul class="mt-8 space-y-5">
          {a.philosophy.map((p, i) => <li class="max-w-[46ch] border-l-2 border-ice pl-5" data-reveal style={`--d:${i * 90}ms`}>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap grid gap-8 border-t border-foam/[0.08] py-20 md:grid-cols-12 md:gap-10 md:py-28">
    <h2 class="md:col-span-4 text-[0.95rem] text-haze" data-reveal>{a.ambitionsTitle}</h2>
    <div class="md:col-span-8">
      <p class="text-[clamp(1.4rem,1.1rem+1.2vw,2.2rem)] leading-[1.3] tracking-[-0.02em] max-w-[36ch]" data-reveal>{a.ambitions}</p>
      <a class="mt-10 inline-block link text-lead" href={href(lang, '/vision')}>{a.visionLink}</a>
    </div>
  </section>
</Base>
