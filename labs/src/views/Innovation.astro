---
import { CodeXml, Brain, Network, FlaskConical } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const n = t[lang].innovation;
const icons = { code: CodeXml, brain: Brain, network: Network, flask: FlaskConical } as const;
---
<Base lang={lang} title={n.title} description={n.description}>
  <PageHead title={n.headline} lead={n.lead} />
  <section class="wrap pb-20 md:pb-28">
    <div class="grid border-t border-ink/12 md:grid-cols-2">
      {n.areas.map((a, i) => {
        const Icon = icons[a.icon as keyof typeof icons];
        return (
          <article class:list={['border-b border-ink/12 py-12 md:py-16', i % 2 === 0 ? 'md:pr-12 md:border-r' : 'md:pl-12']}>
            <Icon class="size-8 text-river" stroke-width={1.5} aria-hidden="true" />
            <h2 class="mt-6 text-[clamp(1.6rem,1.25rem+1.2vw,2.3rem)] leading-tight tracking-[-0.025em]">{a.title}</h2>
            <p class="mt-5 max-w-[46ch] text-slate">{a.now}</p>
            <p class="mt-3 max-w-[46ch]">{a.aim}</p>
          </article>
        );
      })}
    </div>
  </section>
</Base>
