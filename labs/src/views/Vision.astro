---
import { Check, Circle, LoaderCircle, KeyRound, BadgeCheck, PenLine, MonitorSmartphone, X } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Rise from '../components/Rise.astro';
import { products } from '../products';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const v = t[lang].vision;
const accent = (name: string) => products.find((p) => p.name === name)?.accent ?? '#ff3b5c';
const howIcons = [KeyRound, BadgeCheck, PenLine, MonitorSmartphone];
// Six apps around the identity, on a circle (desktop drawing).
const ring = v.apps.map((a, i) => {
  const ang = (-90 + i * 60) * (Math.PI / 180);
  return { ...a, x: 50 + Math.cos(ang) * 38, y: 50 + Math.sin(ang) * 38 };
});
---
<Base lang={lang} title={v.title} description={v.description}>
  <PageHead title={v.motto} lead={v.lead} />

  <!-- ── Droplet ID: the ambition, drawn ───────────────────────────── -->
  <section class="relative isolate overflow-hidden border-t border-foam/[0.08]">
    <div class="glow -z-10 left-1/2 top-1/3 h-[34rem] w-[34rem] -translate-x-1/2 bg-current/30"></div>
    <div class="wrap grid gap-14 py-24 md:py-32 lg:grid-cols-12 lg:items-center lg:gap-10">
      <div class="lg:col-span-5">
        <Rise text={v.idTitle} class="text-mega" />
        <p class="mt-8 max-w-[42ch] text-lead text-haze" data-reveal>{v.idLead}</p>
        <div class="mt-8 flex flex-wrap gap-5 text-[0.9rem] text-haze" data-reveal>
          <span class="flex items-center gap-2"><span class="h-[2px] w-6 rounded bg-ice shadow-[0_0_8px_#8eeaf5]"></span>{v.today}</span>
          <span class="flex items-center gap-2"><span class="h-0 w-6 border-t border-dashed border-foam/40"></span>{v.planned}</span>
        </div>
        <p class="mt-8 max-w-[42ch] text-[0.95rem] text-haze/90" data-reveal>{v.idNote}</p>
      </div>

      <div class="lg:col-span-7" data-lift>
        <!-- Large screens: the identity at the centre, the apps around it. -->
        <div class="relative mx-auto hidden aspect-square max-w-[40rem] sm:block">
          <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" aria-hidden="true">
            {ring.map((a) => a.state === 'today' ? (
              <g>
                <line x1="50" y1="50" x2={a.x} y2={a.y} stroke="#8eeaf5" stroke-opacity="0.55" stroke-width="0.35" />
                <line x1="50" y1="50" x2={a.x} y2={a.y} stroke="#e9fbff" stroke-width="0.6" stroke-linecap="round" stroke-dasharray="2 40" class="id-flow" />
              </g>
            ) : (
              <line x1="50" y1="50" x2={a.x} y2={a.y} stroke="#e9f3f6" stroke-opacity="0.22" stroke-width="0.3" stroke-dasharray="1.2 1.4" />
            ))}
          </svg>
          <div class="absolute left-1/2 top-1/2 flex aspect-square w-[38%] -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center rounded-full bg-[radial-gradient(circle_at_35%_30%,#13506a,#06202d_70%)] p-4 text-center ring-1 ring-ice/40 shadow-[0_0_80px_-10px_rgba(142,234,245,0.45)]">
            <KeyRound class="size-7 text-ice" stroke-width={1.5} aria-hidden="true" />
            <p class="mt-2 text-[clamp(0.95rem,0.7rem+0.8vw,1.25rem)] font-[560] tracking-[-0.01em]">{v.idCenter}</p>
            <p class="mt-1 max-w-[18ch] text-[0.72rem] leading-snug text-haze">{v.idCenterSub}</p>
          </div>
          {ring.map((a) => (
            <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${a.x}%;top:${a.y}%`}>
              <div class:list={['flex flex-col items-center gap-1 rounded-2xl px-3.5 py-2.5 text-center backdrop-blur', a.state === 'today' ? 'bg-abyss/80 ring-1 ring-ice/40' : 'bg-abyss/70 ring-1 ring-foam/12']}>
                <span class="flex items-center gap-2 whitespace-nowrap text-[0.92rem]">
                  <span class="size-2 rounded-full" style={`background:${accent(a.name)};box-shadow:0 0 12px ${accent(a.name)}`}></span>{a.name}
                </span>
                <span class:list={['text-[0.75rem]', a.state === 'today' ? 'text-ice' : 'text-haze']}>{a.state === 'today' ? v.today : v.planned}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Phones: the same, as a list hanging from the identity. -->
        <div class="sm:hidden">
          <div class="flex items-center gap-4 rounded-[24px] bg-[radial-gradient(circle_at_20%_30%,#13506a,#06202d_70%)] p-5 ring-1 ring-ice/40">
            <KeyRound class="size-7 shrink-0 text-ice" stroke-width={1.5} aria-hidden="true" />
            <div><p class="font-[560]">{v.idCenter}</p><p class="text-[0.85rem] text-haze">{v.idCenterSub}</p></div>
          </div>
          <ul class="ml-8 border-l border-foam/15">
            {v.apps.map((a) => (
              <li class="relative flex items-center justify-between gap-3 py-3 pl-6">
                <span class:list={['absolute left-0 top-1/2 w-4', a.state === 'today' ? 'border-t-2 border-ice' : 'border-t border-dashed border-foam/40']}></span>
                <span class="flex items-center gap-2"><span class="size-2 rounded-full" style={`background:${accent(a.name)}`}></span>{a.name}</span>
                <span class:list={['text-[0.82rem]', a.state === 'today' ? 'text-ice' : 'text-haze']}>{a.state === 'today' ? v.today : v.planned}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How it works: a real sequence ─────────────────────────────── -->
  <section class="border-t border-foam/[0.08] bg-trench/60">
    <div class="wrap py-24 md:py-32">
      <Rise text={v.howTitle} class="text-title" />
      <ol class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {v.how.map((s, i) => {
          const Icon = howIcons[i];
          return (
            <li class="glass rounded-[28px] p-7" data-reveal style={`--d:${i * 100}ms`}>
              <div class="flex items-center justify-between">
                <Icon class="size-7 text-ice" stroke-width={1.5} aria-hidden="true" />
                <span class="text-[0.9rem] tabular-nums text-haze">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mt-8 text-[1.35rem] leading-tight tracking-[-0.02em]">{s.title}</h3>
              <p class="mt-3 text-haze">{s.text}</p>
            </li>
          );
        })}
      </ol>

      <div class="mt-14 rounded-[28px] p-7 ring-1 ring-foam/10 md:p-10" data-reveal>
        <h3 class="text-[1.35rem] tracking-[-0.02em]">{v.neverTitle}</h3>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {v.never.map((n) => (
            <li class="flex items-center gap-3 text-lead"><span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-foam/[0.07] ring-1 ring-foam/15"><X class="size-4 text-haze" aria-hidden="true" /></span>{n}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Values ────────────────────────────────────────────────────── -->
  <section class="border-t border-foam/[0.08]">
    <div class="wrap py-24 md:py-32">
      <Rise text={v.valuesTitle} class="text-title" />
      <div class="mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
        {v.values.map((val, i) => (
          <div class="border-t border-ice/40 pt-8" data-reveal style={`--d:${i * 110}ms`}>
            <h3 class="text-[clamp(2rem,1.4rem+1.8vw,3rem)] leading-none tracking-[-0.04em]">{val.title}</h3>
            <p class="mt-6 max-w-[38ch] text-lead text-foam/90">{val.text}</p>
            <p class="mt-5 max-w-[38ch] text-[0.95rem] text-haze">{val.proof}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Roadmap: a real sequence, numbered; only phase 1 is lit ────── -->
  <section class="border-t border-foam/[0.08] bg-trench/60">
    <div class="wrap py-24 md:py-32">
      <Rise text={v.roadmapTitle} class="text-title max-w-[18ch]" />
      <p class="mt-8 max-w-[52ch] text-lead text-haze" data-reveal>{v.roadmapLead}</p>

      <ol class="relative mt-16">
        <span class="absolute left-[11px] top-2 bottom-2 w-px bg-foam/12" aria-hidden="true"></span>
        <span class="absolute left-[11px] top-2 h-[22%] w-px bg-gradient-to-b from-ice to-transparent shadow-[0_0_14px_#8eeaf5]" aria-hidden="true"></span>
        {v.phases.map((p, i) => (
          <li class="relative grid gap-6 pb-16 pl-12 last:pb-0 lg:grid-cols-12 lg:gap-10" data-reveal style={`--d:${i * 80}ms`}>
            <span aria-hidden="true" class:list={['absolute left-0 top-1 size-[23px] rounded-full', i === 0 ? 'bg-ice shadow-[0_0_0_6px_rgba(142,234,245,0.18),0_0_30px_#8eeaf5]' : 'border border-foam/35 bg-abyss']}></span>
            <div class="lg:col-span-4">
              <p class="flex items-baseline gap-3">
                <span class="text-[clamp(2.6rem,1.8rem+2.4vw,4rem)] leading-none tracking-[-0.05em] font-[500] tabular-nums" style={i === 0 ? '' : 'color:color-mix(in oklab, var(--color-foam) 40%, transparent)'}>{String(i + 1).padStart(2, '0')}</span>
                <span class:list={['text-[0.9rem]', i === 0 ? 'text-ice' : 'text-haze']}>{i === 0 ? v.current : v.plannedPhase}</span>
              </p>
              <h3 class="mt-4 text-[clamp(1.5rem,1.2rem+1vw,2.1rem)] leading-[1.12] tracking-[-0.03em]">{p.title}</h3>
            </div>
            <div class="lg:col-span-8 grid gap-6 md:grid-cols-2">
              <div>
                <p class="text-[0.88rem] text-haze">{v.goal}</p>
                <p class="mt-2 text-lead">{p.goal}</p>
                <p class="mt-6 text-[0.88rem] text-haze">{v.doneWhen}</p>
                <p class="mt-2 text-foam/85">{p.doneWhen}</p>
              </div>
              <div class="glass rounded-[24px] p-6">
                <p class="text-[0.88rem] text-haze">{v.steps}</p>
                <ul class="mt-4 space-y-3">
                  {p.steps.map((s) => (
                    <li class="flex gap-3">
                      {s.state === 'done' && <Check class="mt-0.5 size-5 shrink-0 text-ice" aria-hidden="true" />}
                      {s.state === 'progress' && <LoaderCircle class="mt-0.5 size-5 shrink-0 text-ice/80" aria-hidden="true" />}
                      {s.state === 'todo' && <Circle class="mt-0.5 size-5 shrink-0 text-foam/30" aria-hidden="true" />}
                      <span class:list={[s.state === 'todo' ? 'text-foam/75' : '']}>
                        {s.text}
                        {s.state !== 'todo' && <span class="sr-only"> ({s.state === 'done' ? v.done : v.inProgress})</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-12 flex flex-wrap gap-6 text-[0.88rem] text-haze" data-reveal>
        <span class="flex items-center gap-2"><Check class="size-4 text-ice" aria-hidden="true" />{v.done}</span>
        <span class="flex items-center gap-2"><LoaderCircle class="size-4 text-ice/80" aria-hidden="true" />{v.inProgress}</span>
        <span class="flex items-center gap-2"><Circle class="size-4 text-foam/30" aria-hidden="true" />{v.plannedPhase}</span>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Light travelling from the identity to the apps it already opens. */
  .id-flow { animation: id-flow 2.6s linear infinite; }
  @keyframes id-flow { from { stroke-dashoffset: 42; } to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .id-flow { animation: none; display: none; } }
</style>
