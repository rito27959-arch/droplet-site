---
import Base from '../layouts/Base.astro';
import { t, href, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const n = t[lang].notFound;
---
<Base lang={lang} title={n.title} description={n.description}>
  <section class="wrap py-24 md:py-36">
    <h1 class="max-w-[14ch] text-[clamp(2.5rem,1.5rem+4.4vw,5.25rem)] leading-[1] tracking-[-0.032em] font-[440]">{n.headline}</h1>
    <p class="mt-8 text-lead text-slate">{n.text}</p>
    <a class="mt-10 btn btn-primary" href={href(lang, '/')}>{n.back}</a>
  </section>
</Base>
