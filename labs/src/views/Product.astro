---
import { ArrowUpRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import { products, type Product } from '../products';
import { t, href, type Lang } from '../i18n';

interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const d = t[lang].products;
const i = products.findIndex((x) => x.slug === p.slug);
const next = products[(i + 1) % products.length];
const host = p.website ? new URL(p.website).host : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: p.description[lang],
  ...(p.website ? { url: p.website } : {}),
};
---
<Base lang={lang} title={p.name} description={p.line[lang]} jsonLd={jsonLd}>
  <header class="wrap pt-12 pb-14 md:pt-20 md:pb-20">
    <a class="link text-[0.95rem] text-slate" href={href(lang, '/products')}>{d.back}</a>
    <h1 class="mt-8 text-[clamp(2.75rem,1.5rem+5.4vw,6.25rem)] leading-[0.98] tracking-[-0.035em] font-[440]">{p.name}</h1>
    <p class="mt-8 max-w-[44ch] text-lead text-slate">{p.line[lang]}</p>
  </header>

  <section class="wrap rule grid gap-12 py-16 md:grid-cols-12 md:gap-8 md:py-20">
    <div class="md:col-span-7">
      <p class="text-[clamp(1.15rem,1rem+0.6vw,1.45rem)] leading-[1.5] max-w-[52ch]">{p.description[lang]}</p>

      <h2 class="mt-14 text-[1.05rem] font-[560] text-river">{d.objectivesTitle}</h2>
      <ul class="mt-5 space-y-4">
        {p.objectives[lang].map((o) => <li class="max-w-[52ch] border-l-2 border-river pl-5">{o}</li>)}
      </ul>

      <h2 class="mt-14 text-[1.05rem] font-[560] text-river">{d.roadmapTitle}</h2>
      <ul class="mt-5 space-y-3">
        {p.roadmap[lang].map((r) => <li class="max-w-[52ch] pl-5 relative before:absolute before:left-0 before:top-[0.7em] before:size-1.5 before:rounded-full before:border before:border-ink/50">{r}</li>)}
      </ul>
    </div>

    <aside class="md:col-span-4 md:col-start-9 space-y-10">
      <div class="rounded-[22px] bg-foam p-6">
        <h2 class="text-[0.95rem] font-[560] text-slate">{d.statusTitle}</h2>
        <p class="mt-3">{p.status[lang]}</p>
      </div>
      <div>
        <h2 class="text-[0.95rem] font-[560] text-slate">{d.technologiesTitle}</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {p.technologies.map((tech) => <li class="rounded-full bg-dew/70 px-3 py-1 text-[0.88rem]">{tech}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-[0.95rem] font-[560] text-slate">{d.websiteTitle}</h2>
        {p.website ? (
          <a class="mt-3 inline-flex items-center gap-1.5 text-lead text-river link" href={p.website} rel="noopener">
            {host}<ArrowUpRight class="size-5" aria-hidden="true" />
          </a>
        ) : <p class="mt-3 text-slate">{d.noWebsite}</p>}
      </div>
      <p class="text-[0.85rem] text-slate">{d.checked}</p>
    </aside>
  </section>

  <nav class="wrap rule py-12 md:py-16" aria-label={d.next}>
    <a href={href(lang, `/products/${next.slug}`)} class="group block">
      <span class="text-[0.95rem] text-slate">{d.next}</span>
      <span class="mt-2 block text-[clamp(1.8rem,1.3rem+2vw,3rem)] tracking-[-0.03em] leading-tight transition-colors group-hover:text-river">{next.name}</span>
    </a>
  </nav>
</Base>
