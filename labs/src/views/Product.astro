---
import { ArrowUpRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Rise from '../components/Rise.astro';
import ProductMedia from '../components/ProductMedia.astro';
import Phone3D from '../components/Phone3D.astro';
import screenMessenger from '../assets/media/screen-messenger.png';
import screenDrop from '../assets/media/screen-drop.png';
import paroleSession from '../assets/media/parole-session.png';
import { products, type Product } from '../products';
import { t, href, type Lang } from '../i18n';

interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const d = t[lang].products;
const i = products.findIndex((x) => x.slug === p.slug);
const next = products[(i + 1) % products.length];
const host = p.website ? new URL(p.website).host : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: p.description[lang],
  ...(p.website ? { url: p.website } : {}),
};
const started = lang === 'fr' ? 'Commencé en' : 'Started in';
const fr = lang === 'fr';
// The phone, for the projects that live on one. Kunfox (a mascot) and
// NexFleet (a web dashboard) have no phone screen to show yet.
const phone = {
  'droplet-messenger': { screen: screenMessenger, title: fr ? 'Dans la main.' : 'In your hand.',
    text: fr ? 'Une conversation reçue sans réseau, relayée par un téléphone voisin. Tournez le téléphone : il suit votre curseur.' : 'A conversation received with no network, relayed by a nearby phone. Move your pointer: the phone follows it.',
    alt: fr ? 'Droplet Messenger : une conversation avec Amina, à portée par Bluetooth' : 'Droplet Messenger: a chat with Amina, in range over Bluetooth' },
  'droplet-drop': { screen: screenDrop, title: fr ? 'Dans la main.' : 'In your hand.',
    text: fr ? 'Quatre fichiers reçus d’un ordinateur par le Wi-Fi local, chacun vérifié bloc par bloc.' : 'Four files received from a laptop over local Wi-Fi, each one verified block by block.',
    alt: fr ? 'Droplet Drop : réception terminée, tout est arrivé et vérifié' : 'Droplet Drop: receiving done, everything arrived and verified' },
  parole: { screen: paroleSession, title: fr ? 'Dans la main.' : 'In your hand.',
    text: fr ? 'Une question du jury, tirée d’une page précise du rapport de l’étudiant.' : 'A jury question, taken from a specific page of the student’s report.',
    alt: fr ? 'Parole : une question du jury, tirée de la page 18 du rapport' : 'Parole: a jury question, taken from page 18 of the report' },
}[p.slug as 'parole'];
---
<Base lang={lang} title={p.name} description={p.line[lang]} jsonLd={jsonLd}>
  <!-- A hero lit in the project's own colour. -->
  <header class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10" style={`background:radial-gradient(80% 70% at 75% 10%, color-mix(in oklab, ${p.accent} 30%, var(--color-abyss)) 0%, var(--color-abyss) 70%)`}></div>
    <div class="wrap pt-36 md:pt-48">
      <a class="link text-[0.95rem] text-haze hover:text-foam" href={href(lang, '/products')} data-reveal>{d.back}</a>
      <p class="mt-10 flex items-center gap-3 text-[0.95rem] text-haze" data-reveal>
        <span class="size-2.5 rounded-full" style={`background:${p.accent};box-shadow:0 0 20px ${p.accent}`}></span>{p.stage[lang]}
      </p>
      <Rise as="h1" text={p.name} class="mt-5 text-hero font-[500] max-w-[11ch]" />
      <p class="mt-10 max-w-[40ch] text-lead text-haze" data-reveal style="--d:300ms">{p.line[lang]}</p>
    </div>
    <div class="wrap pt-16 pb-20 md:pt-24 md:pb-28" data-lift>
      <div class:list={[p.slug === 'kunfox' || p.slug === 'parole' ? 'max-w-[40rem] mx-auto' : '']}>
        <ProductMedia slug={p.slug} lang={lang} large />
      </div>
    </div>
  </header>

  {phone && (
    <section class="relative isolate overflow-hidden border-t border-foam/[0.08]">
      <div class="wrap grid items-center gap-16 py-24 md:grid-cols-12 md:gap-10 md:py-36">
        <div class="md:col-span-5">
          <Rise text={phone.title} class="text-title" />
          <p class="mt-8 max-w-[34ch] text-lead text-haze" data-reveal style="--d:200ms">{phone.text}</p>
        </div>
        <div class="md:col-span-7 py-6">
          <Phone3D screen={phone.screen} alt={phone.alt} accent={p.accent} name={p.name} />
        </div>
      </div>
    </section>
  )}

  <section class="wrap grid gap-16 border-t border-foam/[0.08] py-20 md:grid-cols-12 md:gap-10 md:py-28">
    <div class="md:col-span-7">
      <p class="text-[clamp(1.3rem,1.05rem+1vw,1.9rem)] leading-[1.4] tracking-[-0.015em] max-w-[44ch]" data-reveal>{p.description[lang]}</p>

      <h2 class="mt-16 text-[0.95rem] text-haze" data-reveal>{d.objectivesTitle}</h2>
      <ul class="mt-6 space-y-5">
        {p.objectives[lang].map((o, k) => (
          <li class="max-w-[50ch] border-l-2 pl-5 text-lead" style={`border-color:${p.accent};--d:${k * 80}ms`} data-reveal>{o}</li>
        ))}
      </ul>

      <h2 class="mt-16 text-[0.95rem] text-haze" data-reveal>{d.roadmapTitle}</h2>
      <ul class="mt-6 space-y-4">
        {p.roadmap[lang].map((r, k) => (
          <li class="relative max-w-[50ch] pl-7" data-reveal style={`--d:${k * 80}ms`}>
            <span class="absolute left-0 top-[0.55em] size-2.5 rounded-full border border-foam/50"></span>{r}
          </li>
        ))}
      </ul>
    </div>

    <aside class="md:col-span-4 md:col-start-9 space-y-6">
      <div class="glass rounded-[26px] p-7" data-reveal>
        <h2 class="text-[0.9rem] text-haze">{d.statusTitle}</h2>
        <p class="mt-3">{p.status[lang]}</p>
        <p class="mt-5 text-[0.9rem] text-haze">{started} {p.started[lang].toLowerCase()}</p>
      </div>
      <div class="glass rounded-[26px] p-7" data-reveal style="--d:100ms">
        <h2 class="text-[0.9rem] text-haze">{d.technologiesTitle}</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {p.technologies.map((tech) => <li class="rounded-full bg-foam/[0.07] px-3 py-1 text-[0.88rem] ring-1 ring-foam/10">{tech}</li>)}
        </ul>
      </div>
      <div class="glass rounded-[26px] p-7" data-reveal style="--d:200ms">
        <h2 class="text-[0.9rem] text-haze">{d.websiteTitle}</h2>
        {p.website ? (
          <a class="mt-3 inline-flex max-w-full items-center gap-1.5 text-lead link [overflow-wrap:anywhere] min-w-0" style={`color:color-mix(in oklab, ${p.accent} 55%, white)`} href={p.website} rel="noopener">
            <span class="min-w-0">{host}</span><ArrowUpRight class="size-5 shrink-0" aria-hidden="true" />
          </a>
        ) : <p class="mt-3 text-haze">{d.noWebsite}</p>}
      </div>
      <p class="text-[0.85rem] text-haze/80">{d.checked}</p>
    </aside>
  </section>

  <nav class="relative isolate overflow-hidden border-t border-foam/[0.08]" aria-label={d.next}>
    <a href={href(lang, `/products/${next.slug}`)} class="group wrap block py-20 md:py-28">
      <div class="glow -z-10 right-0 top-0 h-[24rem] w-[24rem] opacity-0 transition-opacity duration-700 group-hover:opacity-40" style={`background:${next.accent}`}></div>
      <span class="text-[0.95rem] text-haze">{d.next}</span>
      <span class="mt-3 flex items-center gap-4 text-mega font-[500] transition-transform duration-700 group-hover:translate-x-3">
        <span class="size-3 rounded-full" style={`background:${next.accent};box-shadow:0 0 24px ${next.accent}`}></span>{next.name}
      </span>
    </a>
  </nav>
</Base>
