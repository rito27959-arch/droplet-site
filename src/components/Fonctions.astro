---
// Ce que fait l'application, au jour : la BRUME, après la nuit du maillage.
// Pas une grille de cartes identiques : une grande pièce (les vocaux, ce
// qu'on utilise le plus), une large (les appels), et des petites. La taille
// dit l'importance.
import type { Textes } from '../i18n/fr';
interface Props { t: Textes }
const { t } = Astro.props;

// Une onde de vocal, fixe : la même à chaque construction.
const barres = Array.from({ length: 34 }, (_, i) =>
  Math.round(6 + (Math.abs(Math.sin(i * 0.9 + 1.3)) * 0.6 + Math.abs(Math.sin(i * 0.37 + 2.6)) * 0.4) * 22),
);
---
<section class="fonctions fond-gris" aria-labelledby="fonctions-titre">
  <div class="contenu">
    <h2 id="fonctions-titre" class="fonctions__titre titre-section apparait">{t.fonctionsTitre}</h2>

    <div class="grille">
      <article class="piece piece--vocal">
        <div class="piece__texte">
          <h3>{t.fVocauxTitre}</h3>
          <p>{t.fVocauxTexte}</p>
        </div>
        <!-- La barre de réécoute, telle qu'elle est dans l'application. -->
        <div class="reecoute" aria-hidden="true">
          <svg class="reecoute__poubelle" viewBox="0 0 24 24" width="24"><path d="M5 7h14M10 7V4.5h4V7M7 7l1 13h8l1-13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
          <div class="reecoute__onde">
            <svg viewBox="0 0 24 24" width="22"><path d="M7.5 5h3v14h-3zM13.5 5h3v14h-3z" fill="currentColor"/></svg>
            <span class="barres">
              {barres.map((b, i) => <i style={`height:${b}px`} class={i < 13 ? 'lu' : ''} />)}
            </span>
            <span class="reecoute__duree">0:27</span>
          </div>
          <span class="reecoute__envoi"><svg viewBox="0 0 24 24" width="20"><path d="M12 18V6M6.5 11.5 12 6l5.5 5.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
      </article>

      <article class="piece piece--appels">
        <div class="piece__texte">
          <h3>{t.fAppelsTitre}</h3>
          <p>{t.fAppelsTexte}</p>
        </div>
        <div class="appel" aria-hidden="true">
          <span class="appel__avatar">P</span>
          <span class="appel__ligne"><i></i><i></i><i></i><i></i><i></i></span>
          <span class="appel__avatar appel__avatar--b">A</span>
        </div>
      </article>

      <article class="piece">
        <svg class="piece__signe" viewBox="0 0 32 32" aria-hidden="true"><circle cx="11" cy="12" r="5"/><circle cx="22" cy="12" r="4"/><path d="M3 26c1-5 4.5-7.5 8-7.5s7 2.5 8 7.5M19 19.2c3.6-.6 7.2 1.3 8.5 6.8"/></svg>
        <h3>{t.fGroupesTitre}</h3>
        <p>{t.fGroupesTexte}</p>
      </article>

      <article class="piece">
        <svg class="piece__signe" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="17" r="10"/><path d="M16 11v6l4 2.5M13 4h6"/></svg>
        <h3>{t.fEphemeresTitre}</h3>
        <p>{t.fEphemeresTexte}</p>
      </article>

      <article class="piece">
        <svg class="piece__signe" viewBox="0 0 32 32" aria-hidden="true"><rect x="7" y="14" width="18" height="13" rx="3.5"/><path d="M11 14v-3.5a5 5 0 0 1 10 0V14M16 19v3"/></svg>
        <h3>{t.fVerrouTitre}</h3>
        <p>{t.fVerrouTexte}</p>
      </article>

      <article class="piece piece--langues">
        <div class="piece__texte">
          <h3>{t.fLanguesTitre}</h3>
          <p>{t.fLanguesTexte}</p>
        </div>
        <p class="bonjours" aria-hidden="true" lang="mul">
          <span>Bonjour</span><span>Hello</span><span lang="ar">مرحبًا</span><span lang="hi">नमस्ते</span><span lang="zh">你好</span><span>Hola</span><span>Olá</span><span lang="ru">Привет</span><span>Hallo</span><span>Ciao</span>
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .fonctions {
    padding: clamp(96px, 12vw, 160px) 0;
  }
  .fonctions .contenu {
    width: min(100% - 2 * var(--gouttiere), var(--large));
  }
  .fonctions__titre {
    max-width: 16ch;
    margin: 0 auto clamp(40px, 6vw, 72px);
    text-align: center;
  }
  .grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: minmax(210px, auto);
    gap: 16px;
  }
  .piece {
    position: relative;
    background: var(--blanc);
    border-radius: 28px;
    padding: 34px;
    overflow: hidden;
  }
  .piece h3 {
    font-size: var(--t-3);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .piece p {
    margin-top: 8px;
    color: var(--texte-jour-2);
    max-width: 30rem;
  }
  .piece__signe {
    width: 32px;
    height: 32px;
    margin-bottom: 22px;
    fill: none;
    stroke: var(--goutte);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* La grande pièce : les vocaux, sur l'encre de l'application. */
  .piece--vocal {
    grid-row: span 2;
    border-radius: 28px;
    background: radial-gradient(90% 70% at 70% 30%, var(--goutte-nuit), #000 70%);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 460px;
    box-shadow: none;
  }
  .piece--vocal p {
    color: rgba(255, 255, 255, 0.68);
  }
  .reecoute {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 10px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .reecoute__poubelle {
    color: var(--goutte-pale);
    flex: none;
  }
  .reecoute__onde {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 12px 0 8px;
    border-radius: 20px;
    color: var(--goutte);
    background: color-mix(in srgb, var(--goutte) 16%, transparent);
  }
  .barres {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 28px;
    overflow: hidden;
  }
  .barres i {
    flex: 1;
    min-width: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--goutte) 40%, transparent);
  }
  .barres i.lu {
    background: var(--goutte);
  }
  .reecoute__duree {
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .reecoute__envoi {
    width: 40px;
    height: 40px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--goutte);
  }
  /* La vidéo ronde, en filigrane derrière la barre. */
  .ronde {
    position: absolute;
    inset-inline-end: -40px;
    top: 38%;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 40% 35%, #ffb36b 0, #ff5e7e 35%, #6c3fd1 75%);
    opacity: 0.85;
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.08);
  }
  .ronde span {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 3px solid transparent;
    border-top-color: #fff;
    border-right-color: #fff;
    opacity: 0.85;
  }

  .piece--appels {
    grid-column: span 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .appel {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .appel__avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    font-family: var(--f-titre);
    font-weight: 700;
    font-size: 1.3rem;
    background: linear-gradient(135deg, #30b0c7, #007aff);
  }
  .appel__avatar--b {
    background: linear-gradient(135deg, #ff9f0a, #ff375f);
  }
  .appel__ligne {
    display: flex;
    gap: 6px;
  }
  .appel__ligne i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    opacity: 0.35;
  }
  .appel__ligne i:nth-child(3) {
    opacity: 1;
    background: var(--goutte);
  }

  .piece--langues {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
  }
  .bonjours {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-family: var(--f-titre);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--encre);
    margin: 0;
    letter-spacing: -0.02em;
  }
  .bonjours span:nth-child(odd) {
    color: var(--texte-jour-2);
    font-weight: 500;
  }

  @media (max-width: 920px) {
    .grille {
      grid-template-columns: 1fr 1fr;
    }
    .piece--vocal {
      grid-column: span 2;
      grid-row: auto;
      min-height: 380px;
    }
    .piece--langues {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .grille {
      grid-template-columns: 1fr;
    }
    .piece--vocal,
    .piece--appels,
    .piece--langues {
      grid-column: auto;
    }
    .piece--appels {
      flex-direction: column;
      align-items: flex-start;
    }
    .ronde {
      width: 130px;
      height: 130px;
      top: 40%;
    }
  }
</style>
