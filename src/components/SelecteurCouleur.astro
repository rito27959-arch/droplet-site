---
// LE SÉLECTEUR DE COULEUR — à la manière des pastilles de finition d'apple.com.
//
// Deux présentations, un seul comportement :
//   • « nav » : une pastille dans la barre du haut, qui ouvre un petit
//     panneau de verre. Toujours à portée, où qu'on soit sur la page.
//   • « scene » : la rangée de pastilles sous le produit, avec le nom de la
//     couleur au-dessus — exactement là où Apple fait choisir une finition.
//
// Choisir une couleur change `--goutte` sur toute la page ; grâce à
// `@property` (global.css), tout glisse vers la nouvelle teinte au lieu de
// basculer. Le choix est retenu par le navigateur, et réappliqué AVANT le
// premier affichage (voir le script en ligne de `Base.astro`) : pas d'éclair
// rose au chargement quand on a choisi le bleu.
import type { Textes } from '../i18n/fr';
import { COULEURS } from '../couleurs';

interface Props { t: Textes; variante: 'nav' | 'scene' }
const { t, variante } = Astro.props;
const idPanneau = 'panneau-couleur';
---
{variante === 'nav' ? (
  <div class="sc sc--nav">
    <button
      class="sc__ouvrir"
      type="button"
      popovertarget={idPanneau}
      aria-label={t.couleurBouton}
      title={t.couleurBouton}
    >
      <span class="sc__point" />
    </button>
    <div id={idPanneau} class="sc__panneau" popover>
      <p class="sc__nom" data-nom-couleur>{t.couleurs.rose}</p>
      <div class="sc__rangee" role="radiogroup" aria-label={t.couleurBouton}>
        {COULEURS.map((c, i) => (
          <button
            type="button"
            role="radio"
            class="sc__pastille"
            style={`--c:${c.hex}`}
            data-couleur={c.cle}
            data-hex={c.hex}
            data-nom={t.couleurs[c.cle]}
            aria-label={t.couleurs[c.cle]}
            aria-checked={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          />
        ))}
      </div>
    </div>
  </div>
) : (
  <div class="sc sc--scene">
    <p class="sc__titre">{t.couleurTitre}</p>
    <p class="sc__nom" data-nom-couleur aria-live="polite">{t.couleurs.rose}</p>
    <div class="sc__rangee" role="radiogroup" aria-label={t.couleurBouton}>
      {COULEURS.map((c, i) => (
        <button
          type="button"
          role="radio"
          class="sc__pastille"
          style={`--c:${c.hex}`}
          data-couleur={c.cle}
          data-hex={c.hex}
          data-nom={t.couleurs[c.cle]}
          aria-label={t.couleurs[c.cle]}
          aria-checked={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        />
      ))}
    </div>
  </div>
)}

<style>
  .sc__rangee {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  /* La pastille : la couleur pleine, un fin liseré intérieur pour qu'elle
     tienne sur le noir comme sur le blanc. Choisie, un anneau s'écarte
     autour d'elle — le geste d'apple.com. */
  .sc__pastille {
    position: relative;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    /* Un bouton a sa propre couleur de texte (noire) : l'anneau, tracé en
       `currentColor`, doit prendre celle de la section. */
    color: inherit;
    background:
      radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.35), transparent 55%),
      var(--c);
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.25);
    transition: transform 0.35s var(--ease-sortie);
  }
  .sc__pastille::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 0.3s var(--ease),
      transform 0.45s var(--ease-sortie);
  }
  .sc__pastille:hover {
    transform: scale(1.1);
  }
  .sc__pastille[aria-checked='true']::after {
    opacity: 0.85;
    transform: scale(1);
  }
  .sc__pastille:focus-visible {
    outline: 2px solid var(--lien-sombre);
    outline-offset: 6px;
  }
  .sc__nom {
    font-size: var(--t-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    min-height: 1.4em;
  }

  /* ── Dans la scène, sous les téléphones ─────────────────────────── */
  .sc--scene {
    display: grid;
    justify-items: center;
    gap: 10px;
    margin-top: 34px;
    color: var(--clair);
  }
  .sc--scene .sc__titre {
    font-family: var(--f-titre);
    font-size: var(--t-2);
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .sc--scene .sc__nom {
    color: var(--clair-2);
    margin-bottom: 4px;
  }
  .sc--scene .sc__pastille {
    width: 28px;
    height: 28px;
  }

  /* ── Dans la barre du haut ──────────────────────────────────────── */
  .sc__ouvrir {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  /* La pastille de la barre : la couleur choisie, cerclée d'un anneau des
     autres teintes — on comprend d'un regard qu'on peut en changer. */
  .sc__point {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--goutte);
    position: relative;
    /* Son propre contexte d'empilement : l'anneau (`::before`, z-index -1)
       passe derrière la pastille, pas derrière la barre entière. */
    isolation: isolate;
  }
  .sc__point::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: conic-gradient(#ff2d55, #ff9f0a, #30d158, #00c7be, #0a84ff, #5e5ce6, #bf5af2, #ff2d55);
    z-index: -1;
    -webkit-mask: radial-gradient(circle, transparent 9.5px, #000 10px);
    mask: radial-gradient(circle, transparent 9.5px, #000 10px);
  }
  .sc__panneau {
    /* Le panneau natif (`popover`) : il se ferme tout seul d'un clic
       ailleurs ou avec Échap, et passe au-dessus de tout. */
    position: fixed;
    inset: 60px max(var(--gouttiere), calc((100vw - var(--large)) / 2)) auto auto;
    margin: 0;
    padding: 16px 18px 18px;
    border: 0;
    border-radius: 22px;
    color: var(--clair);
    background: rgba(30, 30, 32, 0.78);
    backdrop-filter: saturate(180%) blur(24px);
    -webkit-backdrop-filter: saturate(180%) blur(24px);
    box-shadow:
      inset 0 0.5px 0 rgba(255, 255, 255, 0.25),
      0 0 0 0.5px rgba(255, 255, 255, 0.1),
      0 24px 60px -12px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    transform-origin: top right;
    transition:
      opacity 0.25s var(--ease),
      transform 0.35s var(--ease-sortie),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }
  .sc__panneau:popover-open {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .sc__panneau:popover-open {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }
  .sc__panneau .sc__nom {
    text-align: center;
    margin-bottom: 12px;
    color: var(--clair-2);
  }
  .sc__panneau .sc__rangee {
    display: grid;
    grid-template-columns: repeat(4, 24px);
    gap: 16px;
  }
  :global([dir='rtl']) .sc__panneau {
    inset: 60px auto auto max(var(--gouttiere), calc((100vw - var(--large)) / 2));
    transform-origin: top left;
  }
</style>

<script>
  import { CLE_STOCKAGE, COULEURS } from '../couleurs';

  const racine = document.documentElement;
  const toutes = () => [...document.querySelectorAll<HTMLButtonElement>('.sc__pastille')];

  function appliquer(cle: string, retenir: boolean) {
    const c = COULEURS.find((x) => x.cle === cle) ?? COULEURS[0];
    racine.style.setProperty('--goutte', c.hex);
    racine.dataset.couleur = c.cle;
    for (const b of toutes()) {
      const choisie = b.dataset.couleur === c.cle;
      b.setAttribute('aria-checked', String(choisie));
      b.tabIndex = choisie ? 0 : -1;
    }
    // Le nom, lu sur une pastille (déjà traduit dans la langue de la page).
    const nom = toutes().find((b) => b.dataset.couleur === c.cle)?.dataset.nom ?? '';
    document.querySelectorAll('[data-nom-couleur]').forEach((el) => (el.textContent = nom));
    if (retenir) {
      try {
        localStorage.setItem(CLE_STOCKAGE, c.cle);
      } catch {
        // Navigation privée ou stockage bloqué : le choix vaut pour la page.
      }
    }
  }

  // L'état posé avant l'affichage par `Base.astro`, ou le rose.
  appliquer(racine.dataset.couleur ?? COULEURS[0].cle, false);

  for (const b of toutes()) {
    b.addEventListener('click', () => appliquer(b.dataset.couleur!, true));
    // Le clavier d'un groupe radio : les flèches passent d'une couleur à
    // l'autre, et la choisissent.
    b.addEventListener('keydown', (e) => {
      const groupe = [...b.parentElement!.querySelectorAll<HTMLButtonElement>('.sc__pastille')];
      const i = groupe.indexOf(b);
      const rtl = racine.dir === 'rtl';
      let pas = 0;
      if (e.key === 'ArrowDown') pas = 1;
      if (e.key === 'ArrowUp') pas = -1;
      if (e.key === 'ArrowRight') pas = rtl ? -1 : 1;
      if (e.key === 'ArrowLeft') pas = rtl ? 1 : -1;
      if (!pas) return;
      e.preventDefault();
      const suivante = groupe[(i + pas + groupe.length) % groupe.length];
      appliquer(suivante.dataset.couleur!, true);
      suivante.focus();
    });
  }
</script>
