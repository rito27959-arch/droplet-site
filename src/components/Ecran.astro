---
// Les écrans de l'application, refaits en HTML d'après Droplet lui-même
// (mêmes couleurs, mêmes bulles, même barre de saisie). Tout est en `em`
// rapporté à la largeur du téléphone (`cqi`) : un écran posé dans un petit
// téléphone est le même écran, en plus petit — comme une vraie capture.
import type { Textes } from '../i18n/fr';

type Vue = 'discussion' | 'liste' | 'vocal' | 'appel';
interface Props {
  t: Textes;
  vue: Vue;
  theme?: 'sombre' | 'clair';
  /** Les bulles arrivent une à une (une seule fois). */
  anime?: boolean;
}
const { t, vue, theme = 'sombre', anime = false } = Astro.props;

const onde = (n: number, graine: number) =>
  Array.from({ length: n }, (_, i) =>
    Math.round(18 + (Math.abs(Math.sin(i * 0.9 + graine)) * 0.6 + Math.abs(Math.sin(i * 0.37 + graine * 2)) * 0.4) * 82),
  );
const coche = `<svg viewBox="0 0 18 12" class="coche"><path d="M1 6.5 4.5 10 11 3M7.5 10 14 3.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<div class={`ecran ecran--${theme} ${anime ? 'ecran--anime' : ''}`}>
  <div class="barre-etat">
    <span>9:41</span>
    <span class="barre-etat__droite">
      <svg viewBox="0 0 18 12"><path d="M1 11h2.5V8H1zm4.5 0H8V5.5H5.5zm4.5 0h2.5V3H10zm4.5 0H17V.5h-2.5z" fill="currentColor"/></svg>
      <svg viewBox="0 0 28 13"><rect x=".5" y=".5" width="24" height="12" rx="3.5" fill="none" stroke="currentColor" opacity=".45"/><rect x="2.2" y="2.2" width="17" height="8.6" rx="2" fill="currentColor"/><path d="M26 4.5v4" stroke="currentColor" stroke-linecap="round" opacity=".45"/></svg>
    </span>
  </div>

  {vue === 'liste' && (
    <div class="liste">
      <div class="liste__haut">
        <svg viewBox="0 0 24 24" class="liste__icone"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="8" cy="12" r="1.3" fill="currentColor"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/><circle cx="16" cy="12" r="1.3" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24" class="liste__icone liste__icone--plein"><circle cx="12" cy="12" r="10.5" fill="currentColor"/><path d="M12 7v10M7 12h10" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
      </div>
      <h4 class="liste__titre">{t.listeTitre}</h4>
      <div class="liste__recherche"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
      {[
        { nom: t.telNom, apercu: t.telM3, heure: '21:04', nonlus: 2, couleur: 'linear-gradient(135deg,#ff9f0a,#ff375f)', en_ligne: true },
        { nom: t.famille, apercu: `${t.parcoursDest} : 0:12`, heure: '20:41', nonlus: 0, couleur: 'linear-gradient(135deg,#34c759,#30b0c7)', en_ligne: false },
        { nom: t.parcoursDest, apercu: t.confClair, heure: '18:02', nonlus: 0, couleur: 'linear-gradient(135deg,#5e5ce6,#007aff)', en_ligne: false, lu: true },
        { nom: 'Lina', apercu: t.u4Texte, heure: '20:12', nonlus: 0, couleur: 'linear-gradient(135deg,#bf5af2,#ff375f)', en_ligne: false, lu: true },
      ].map((r) => (
        <div class="ligne">
          <span class="avatar" style={`background:${r.couleur}`}>{r.nom.charAt(0)}{r.en_ligne && <i class="avatar__point" />}</span>
          <span class="ligne__texte">
            <span class="ligne__haut"><b>{r.nom}</b><small class={r.nonlus ? 'accent' : ''}>{r.heure}</small></span>
            <span class="ligne__bas">
              <span class="ligne__apercu">{r.lu && <span set:html={coche} />}{r.apercu}</span>
              {r.nonlus > 0 && <span class="pastille">{r.nonlus}</span>}
            </span>
          </span>
        </div>
      ))}
    </div>
  )}

  {(vue === 'discussion' || vue === 'vocal') && (
    <>
      <div class="entete">
        <svg class="entete__retour" viewBox="0 0 12 20"><path d="M10 2 2 10l8 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="avatar avatar--petit" style="background:linear-gradient(135deg,#ff9f0a,#ff375f)">{t.telNom.charAt(0)}</span>
        <span class="entete__qui"><b>{t.telNom}</b><small>{t.telEtat}</small></span>
        <svg viewBox="0 0 24 24" class="entete__icone"><rect x="3" y="6.5" width="12.5" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M15.5 10.5l5-3v9l-5-3z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        <svg viewBox="0 0 24 24" class="entete__icone"><path d="M6.6 3.5h2.6l1.4 4-2 1.4a12 12 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2.2-2.2z" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
      </div>
      <div class="fil">
        <p class="fil__chiffre"><svg viewBox="0 0 24 24" class="fil__cadenas"><rect x="5" y="10.5" width="14" height="10" rx="2.5" fill="currentColor"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>{t.conf1Titre}</p>
        <span class="fil__vide"></span>
        {vue === 'discussion' ? (
          <>
            <div class="bulle bulle--recue a1">{t.telM1}<time>21:02</time></div>
            <div class="bulle bulle--envoyee a2">{t.telM2}<time>21:03 <span set:html={coche} /></time></div>
            <div class="frappe a3"><i></i><i></i><i></i></div>
            <div class="bulle bulle--recue a4">{t.telM3}<time>21:04</time></div>
            <div class="relais a5">•••&nbsp;&nbsp;{t.telRelais}</div>
          </>
        ) : (
          <>
            <div class="bulle bulle--recue a1">{t.telM1}<time>21:02</time></div>
            <div class="vocal-bulle vocal-bulle--recue a2">
              <span class="vocal-bulle__jouer"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
              <span class="ondes">{onde(26, 1).map((h) => <i style={`height:${h}%`} />)}</span>
              <span class="vocal-bulle__pied"><span>0:19</span><time>21:03</time></span>
            </div>
          </>
        )}
      </div>
      {vue === 'discussion' ? (
        <div class="saisie">
          <svg viewBox="0 0 24 24" class="saisie__svg saisie__svg--plus"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="saisie__champ">{t.telSaisie}</span>
          <svg viewBox="0 0 24 24" class="saisie__svg"><path d="M4 8h3l2-2.5h6L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="13" r="3.6" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
          <svg viewBox="0 0 24 24" class="saisie__svg"><rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </div>
      ) : (
        <div class="reecoute">
          <svg viewBox="0 0 24 24" class="reecoute__poubelle"><path d="M5 7h14M10 7V4.5h4V7M7 7l1 13h8l1-13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
          <span class="reecoute__piste">
            <svg viewBox="0 0 24 24" class="reecoute__pause"><path d="M7 5h3.4v14H7zm6.6 0H17v14h-3.4z" fill="currentColor"/></svg>
            <span class="ondes ondes--piste">{onde(30, 4).map((h, i) => <i style={`height:${h}%`} class={i < 12 ? 'lu' : ''} />)}</span>
            <span class="reecoute__duree">0:27</span>
          </span>
          <span class="reecoute__envoi"><svg viewBox="0 0 24 24"><path d="M12 18V6M6.5 11.5 12 6l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
      )}
    </>
  )}

  {vue === 'appel' && (
    <div class="appel">
      <span class="appel__halo"></span>
      <span class="avatar avatar--grand" style="background:linear-gradient(135deg,#5e5ce6,#007aff)">{t.parcoursDest.charAt(0)}</span>
      <b class="appel__nom">{t.parcoursDest}</b>
      <small class="appel__etat">{t.appelEnCours}</small>
      <span class="appel__duree">02:14</span>
      <span class="appel__boutons">
        <span><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><span><svg viewBox="0 0 24 24"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><span><svg viewBox="0 0 24 24"><rect x="3" y="6.5" width="12.5" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.5 10.5l5-3v9l-5-3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span><span class="raccrocher"><svg viewBox="0 0 24 24"><path d="M3 14.5c4.8-4.4 13.2-4.4 18 0l-2.2 2.6-3.6-1.4v-2.6a10 10 0 0 0-6.4 0v2.6l-3.6 1.4z" fill="currentColor"/></svg></span>
      </span>
    </div>
  )}
</div>

<style>
  .ecran {
    --fond: #000;
    --texte: #fff;
    --texte-2: rgba(235, 235, 245, 0.6);
    --recue: #26262a;
    --barre: rgba(28, 28, 30, 0.85);
    --champ: rgba(118, 118, 128, 0.24);
    --separateur: rgba(84, 84, 88, 0.5);
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    font-size: 4.55cqi;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--texte);
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.045) 0.08em, transparent 0.1em) 0 0 / 2.4em 2.4em,
      var(--fond);
    font-family: var(--f-texte);
    text-align: start;
  }
  .ecran--clair {
    --fond: #fff;
    --texte: #000;
    --texte-2: rgba(60, 60, 67, 0.6);
    --recue: #fff;
    --barre: rgba(249, 249, 249, 0.92);
    --champ: rgba(118, 118, 128, 0.12);
    --separateur: rgba(60, 60, 67, 0.2);
    background:
      radial-gradient(circle, rgba(0, 0, 0, 0.05) 0.08em, transparent 0.1em) 0 0 / 2.4em 2.4em,
      #efe7de;
  }
  .barre-etat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.1em;
    padding: 0.7em 1.9em 0;
    font-weight: 600;
    font-size: 1em;
  }
  .barre-etat__droite {
    display: flex;
    gap: 0.35em;
    align-items: center;
  }
  .barre-etat svg {
    height: 0.8em;
    width: auto;
  }
  .avatar {
    position: relative;
    width: 2.4em;
    height: 2.4em;
    border-radius: 50%;
    flex: none;
    display: grid;
    place-items: center;
    color: #fff;
    font-weight: 700;
  }
  .avatar--petit {
    width: 2.1em;
    height: 2.1em;
    font-size: 0.95em;
  }
  .avatar--grand {
    width: 6.4em;
    height: 6.4em;
    font-size: 1.9em;
  }
  .avatar__point {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    background: #34c759;
    box-shadow: 0 0 0 0.15em var(--fond);
  }
  .accent {
    color: var(--goutte) !important;
  }
  :global(.coche) {
    display: inline-block;
    width: 1.05em;
    height: 0.75em;
    vertical-align: -0.05em;
    margin-inline-end: 0.2em;
  }

  /* ── La liste ── */
  .liste {
    flex: 1;
    padding: 0 0 1em;
    background: var(--fond);
  }
  .liste__haut {
    display: flex;
    justify-content: space-between;
    padding: 0.4em 1.1em;
    color: var(--goutte);
    font-size: 1.1em;
  }
  .liste__titre {
    font-family: var(--f-titre);
    font-size: 2.25em;
    letter-spacing: -0.03em;
    padding: 0.05em 0.5em 0.25em;
    margin: 0;
  }
  .liste__recherche {
    margin: 0.2em 1em 0.8em;
    height: 2.2em;
    border-radius: 0.7em;
    background: var(--champ);
    color: var(--texte-2);
    padding: 0.3em 0.7em;
  }
  .ligne {
    display: flex;
    gap: 0.75em;
    align-items: center;
    padding: 0.62em 1em;
  }
  .ligne .avatar {
    width: 3.2em;
    height: 3.2em;
    font-size: 1.05em;
  }
  .ligne__texte {
    flex: 1;
    min-width: 0;
    padding-bottom: 0.7em;
    border-bottom: 1px solid var(--separateur);
  }
  .ligne__haut,
  .ligne__bas {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5em;
  }
  .ligne__haut b {
    font-size: 1.05em;
  }
  .ligne__haut small {
    color: var(--texte-2);
    font-size: 0.85em;
  }
  .ligne__apercu {
    color: var(--texte-2);
    font-size: 0.92em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pastille {
    min-width: 1.45em;
    height: 1.45em;
    border-radius: 1em;
    padding: 0 0.4em;
    background: var(--goutte);
    color: #fff;
    font-size: 0.78em;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  /* ── La discussion ── */
  .entete {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.45em 1em 0.6em 0.8em;
    color: var(--goutte);
    background: var(--barre);
    border-bottom: 1px solid var(--separateur);
  }
  :global([dir='rtl']) .entete__retour {
    transform: scaleX(-1);
  }
  .entete__retour {
    width: 0.75em;
    height: 1.2em;
  }
  .entete__qui {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    color: var(--texte);
    line-height: 1.2;
  }
  .entete__qui small {
    font-size: 0.76em;
    color: var(--texte-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .entete__icone {
    width: 1.55em;
    height: 1.55em;
    margin-inline-start: 0.3em;
  }
  .fil {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    padding: 0.7em 0.7em 0.6em;
    min-height: 0;
  }
  .fil__vide {
    flex: 1;
  }
  .fil__chiffre {
    align-self: center;
    margin: 0.3em 0 0;
    padding: 0.45em 0.8em;
    border-radius: 0.7em;
    font-size: 0.74em;
    color: #e8d9a0;
    background: rgba(58, 52, 32, 0.9);
  }
  .fil__cadenas {
    display: inline-block;
    width: 0.95em;
    height: 0.95em;
    vertical-align: -0.12em;
    margin-inline-end: 0.35em;
  }
  .ecran--clair .fil__chiffre {
    color: #6b5a1e;
    background: #fff4c4;
  }
  .bulle {
    max-width: 80%;
    padding: 0.45em 0.75em 0.4em;
    border-radius: 1.2em;
    font-size: 0.98em;
  }
  .bulle time {
    float: inline-end;
    display: inline-flex;
    align-items: center;
    margin: 0.45em 0 -0.15em 0.6em;
    font-size: 0.7em;
    opacity: 0.62;
  }
  .bulle--recue {
    align-self: flex-start;
    background: var(--recue);
    border-end-start-radius: 0.35em;
  }
  .ecran--clair .bulle--recue {
    box-shadow: 0 0.05em 0.1em rgba(0, 0, 0, 0.08);
  }
  .bulle--envoyee {
    align-self: flex-end;
    background: var(--goutte);
    color: #fff;
    border-end-end-radius: 0.35em;
  }
  .bulle--envoyee time {
    opacity: 0.85;
  }
  .frappe {
    align-self: flex-start;
    display: flex;
    gap: 0.28em;
    padding: 0.75em 0.9em;
    border-radius: 1.2em;
    background: var(--recue);
  }
  .frappe i {
    width: 0.42em;
    height: 0.42em;
    border-radius: 50%;
    background: var(--texte-2);
    animation: point 1s infinite ease-in-out;
  }
  .frappe i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .frappe i:nth-child(3) {
    animation-delay: 0.3s;
  }
  .relais {
    align-self: flex-start;
    margin-inline-start: 0.3em;
    font-size: 0.74em;
    color: var(--signal);
  }
  .vocal-bulle {
    align-self: flex-start;
    width: 78%;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25em 0.55em;
    align-items: center;
    padding: 0.55em 0.75em 0.45em 0.55em;
    border-radius: 1.2em 1.2em 1.2em 0.35em;
    background: var(--recue);
  }
  .vocal-bulle__jouer {
    width: 2.3em;
    height: 2.3em;
    border-radius: 50%;
    background: var(--goutte);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 0.85em;
  }
  .vocal-bulle__jouer svg,
  .reecoute__envoi svg {
    width: 1.2em;
    height: 1.2em;
  }
  .reecoute__pause {
    width: 1.1em;
    height: 1.1em;
  }
  .liste__icone {
    width: 1.45em;
    height: 1.45em;
  }
  .liste__recherche svg {
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.25em;
  }
  .vocal-bulle__pied {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    font-size: 0.7em;
    color: var(--texte-2);
  }
  .ondes {
    display: flex;
    align-items: center;
    gap: 0.12em;
    height: 1.7em;
  }
  .ondes i {
    flex: 1;
    border-radius: 1em;
    background: var(--goutte);
  }
  .ondes--piste i {
    background: color-mix(in srgb, var(--goutte) 40%, transparent);
  }
  .ondes--piste i.lu {
    background: var(--goutte);
  }
  .saisie {
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin: 0 0.55em 1.6em;
    padding: 0.4em 0.65em;
    border-radius: 1.6em;
    color: var(--texte-2);
    background: var(--barre);
  }
  .saisie__svg--plus {
    width: 1.7em;
    height: 1.7em;
  }
  .saisie__champ {
    flex: 1;
    height: 2.3em;
    display: flex;
    align-items: center;
    padding: 0 0.8em;
    border-radius: 1.15em;
    background: var(--champ);
  }
  .saisie__svg {
    width: 1.5em;
    height: 1.5em;
  }
  .reecoute {
    display: flex;
    align-items: center;
    gap: 0.45em;
    margin: 0 0.55em 1.6em;
    padding: 0.35em;
    border-radius: 1.8em;
    background: var(--barre);
  }
  .reecoute__poubelle {
    width: 1.6em;
    height: 1.6em;
    color: #ff453a;
    margin-inline-start: 0.35em;
  }
  .reecoute__piste {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5em;
    height: 2.6em;
    padding: 0 0.7em 0 0.6em;
    border-radius: 1.3em;
    color: var(--goutte);
    background: color-mix(in srgb, var(--goutte) 14%, transparent);
    font-size: 0.95em;
  }
  .reecoute__piste .ondes {
    flex: 1;
  }
  .reecoute__duree {
    font-size: 0.8em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .reecoute__envoi {
    width: 2.6em;
    height: 2.6em;
