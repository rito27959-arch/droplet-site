---
// LA NAVIGATION — Droplet Design Language.
// Une barre plate et typographique, sans verre, qui s'efface derrière le
// contenu : un filet d'un pixel n'apparaît qu'une fois la page défilée.
// « Produits » ouvre un panneau avec toute la famille Droplet ; sur téléphone,
// « Menu » ouvre un panneau plein écran. Même structure sur tous les sites
// Droplet (dropletmesh.app, drop, Droplet ID, Droplet Labs).
import Logo from './Logo.astro';
import { LIEN_ANDROID } from '../config';
import { famille, type LangueFamille } from '../famille/textes';
import type { Textes } from '../i18n/fr';
import type { Langue } from '../i18n';

interface Props {
  t: Textes;
  accueil: string;
  langue?: Langue;
  /** Sur une page de document, les ancres pointent vers l'accueil. */
  surAccueil?: boolean;
  /** Gardé pour compatibilité ; le fond suit désormais le thème. */
  clairEnHaut?: boolean;
}
const { t, accueil, langue = 'fr', surAccueil = true } = Astro.props;
const f = famille[langue as LangueFamille] ?? famille.fr;
const base = surAccueil ? '' : accueil;
const liens = [
  { texte: t.navFonctionnement, href: `${base}#parcours` },
  { texte: t.navConfidentialite, href: `${base}#confidentialite` },
  { texte: t.piedAssistance, href: `${accueil}support/` },
];
const produits = [
  { nom: 'Droplet', phrase: f.dropletAccroche, plateforme: f.dropletPlateformes, href: accueil, ici: true },
  { nom: 'Droplet Web', phrase: f.webAccroche, plateforme: f.webPlateformes, href: 'https://web.dropletmesh.app' },
  { nom: 'Droplet Drop', phrase: f.dropAccroche, plateforme: f.dropPlateformes, href: langue === 'fr' ? 'https://drop.dropletmesh.app/' : `https://drop.dropletmesh.app/${langue}/` },
  { nom: 'Droplet ID', phrase: t.idAccroche, plateforme: 'Android 12+', href: 'https://dropletid.dropletmesh.app/' },
];
---
<header class="barre" data-barre>
  <div class="barre__dedans contenu--large">
    <a class="barre__marque" href={accueil}>
      <Logo taille={20} actif={false} />
      <span>Droplet</span>
    </a>

    <nav class="barre__liens" aria-label="Droplet">
      <button class="barre__lien" type="button" aria-expanded="false" aria-controls="panneau-produits" data-ouvre="panneau-produits">
        {t.navProduits}
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      {liens.map((l) => <a class="barre__lien" href={l.href}>{l.texte}</a>)}
    </nav>

    <div class="barre__actions">
      <button class="barre__icone" type="button" aria-label={t.themeVersSombre} data-theme-toggle data-sombre={t.themeVersSombre} data-clair={t.themeVersClair}>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="12" cy="12" r="8" />
          <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" stroke="none" />
        </svg>
      </button>
      <a class="bouton bouton--petit barre__telecharger" href={LIEN_ANDROID}>{t.telecharger}</a>
      <button class="barre__menu" type="button" aria-expanded="false" aria-controls="panneau-mobile" data-ouvre="panneau-mobile">{t.menu}</button>
    </div>
  </div>

  <div class="panneau" id="panneau-produits" hidden>
    <ul class="contenu--large panneau__produits">
      {produits.map((p) => (
        <li>
          <a class="panneau__produit" href={p.href} aria-current={p.ici ? 'page' : undefined}>
            <span class="subtitle">{p.nom}</span>
            <span class="caption">{p.phrase}</span>
            <span class="technique doux">{p.plateforme}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="contenu--large panneau__labs caption">
      <a href="https://labs.dropletmesh.app/">Droplet Labs</a><span> {t.labsAccroche}</span>
    </p>
  </div>

  <div class="panneau panneau--plein" id="panneau-mobile" hidden>
    <div class="contenu--large panneau__plein">
      <p class="caption">{t.navProduits}</p>
      <ul class="panneau__liste">
        {produits.map((p) => <li><a class="title" href={p.href}>{p.nom}</a></li>)}
      </ul>
      <ul class="panneau__liste panneau__liste--secondaire">
        {liens.map((l) => <li><a class="subtitle" href={l.href}>{l.texte}</a></li>)}
      </ul>
      <a class="bouton" href={LIEN_ANDROID}>{t.telechargerAndroid}</a>
    </div>
  </div>
</header>

<script>
  const barre = document.querySelector<HTMLElement>('[data-barre]')!;
  const sync = () => barre.classList.toggle('est-defilee', scrollY > 8);
  addEventListener('scroll', sync, { passive: true });
  sync();

  // Panneaux : un seul ouvert à la fois ; Échap ou un clic ailleurs ferme.
  const boutons = [...barre.querySelectorAll<HTMLButtonElement>('[data-ouvre]')];
  const fermer = () =>
    boutons.forEach((b) => {
      b.setAttribute('aria-expanded', 'false');
      document.getElementById(b.dataset.ouvre!)!.hidden = true;
    });
  boutons.forEach((b) =>
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const panneau = document.getElementById(b.dataset.ouvre!)!;
      const ouvrir = panneau.hidden;
      fermer();
      panneau.hidden = !ouvrir;
      b.setAttribute('aria-expanded', String(ouvrir));
      barre.classList.toggle('a-panneau', ouvrir);
      document.documentElement.classList.toggle('sans-defilement', ouvrir && b.dataset.ouvre === 'panneau-mobile');
    }),
  );
  const toutFermer = () => {
    fermer();
    barre.classList.remove('a-panneau');
    document.documentElement.classList.remove('sans-defilement');
  };
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.panneau')) toutFermer();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const ouvert = boutons.find((b) => b.getAttribute('aria-expanded') === 'true');
    toutFermer();
    ouvert?.focus();
  });

  // Thème clair ou sombre, mémorisé.
  const theme = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const libelle = () => {
    const sombre = document.documentElement.dataset.theme === 'dark';
    theme?.setAttribute('aria-label', (sombre ? theme.dataset.clair : theme.dataset.sombre) ?? '');
  };
  libelle();
  theme?.addEventListener('click', () => {
    const suivant = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = suivant;
    try {
      localStorage.setItem('theme', suivant);
    } catch {}
    libelle();
  });
</script>

<style>
  .barre {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--fond);
    transition: box-shadow 150ms ease;
  }
  .barre.est-defilee,
  .barre.a-panneau {
    box-shadow: 0 1px 0 var(--trait);
  }
  .barre__dedans {
    display: flex;
    align-items: center;
    gap: var(--e-6);
    height: 64px;
  }
  .barre__marque {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variation-settings: 'FLAR' 100, 'VOLM' 40;
    text-decoration: none;
  }
  .barre__liens {
    display: flex;
    gap: var(--e-5);
  }
  .barre__lien {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0;
    border: 0;
    background: none;
    color: var(--encre-douce);
    font: 500 15px var(--police);
    text-decoration: none;
    cursor: pointer;
    transition: color 120ms ease;
  }
  .barre__lien:hover,
  .barre__lien[aria-expanded='true'] {
    color: var(--encre);
  }
  .barre__lien svg {
    transition: transform 180ms var(--sortie);
  }
  .barre__lien[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .barre__actions {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    margin-inline-start: auto;
  }
  .barre__icone {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--encre);
    cursor: pointer;
  }
  .barre__icone:hover {
    background: color-mix(in srgb, var(--encre) 7%, transparent);
  }
  .barre__menu {
    display: none;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--trait);
    border-radius: var(--r-pilule);
    background: none;
    color: var(--encre);
    font: 600 14px var(--police);
    cursor: pointer;
  }

  .panneau {
    position: absolute;
    inset: 100% 0 auto 0;
    background: var(--fond);
    box-shadow: 0 1px 0 var(--trait), 0 24px 40px -24px rgb(0 0 0 / 0.25);
    transform-origin: top center;
    animation: panneau 180ms var(--sortie);
  }
  @keyframes panneau {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.985);
    }
  }
  .panneau__produits {
    list-style: none;
    padding: var(--e-5) 0 var(--e-3);
    margin-block: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .panneau__produits li + li {
    border-inline-start: 1px solid var(--trait);
  }
  .panneau__produit {
    display: grid;
    gap: 6px;
    align-content: start;
    height: 100%;
    padding: var(--e-3) var(--e-4);
    border-radius: var(--r-controle);
    text-decoration: none;
    transition: background-color 120ms ease;
  }
  .panneau__produit:hover,
  .panneau__produit:focus-visible {
    background: color-mix(in srgb, var(--encre) 5%, transparent);
  }
  .panneau__labs {
    padding-bottom: var(--e-5);
    padding-inline: var(--e-4);
  }
  .panneau__labs a {
    color: var(--encre);
    font-weight: 600;
  }
  .panneau--plein {
    position: fixed;
    inset: 64px 0 0 0;
    overflow-y: auto;
    animation-duration: 240ms;
  }
  .panneau__plein {
    display: grid;
    gap: var(--e-5);
    padding-block: var(--e-5) var(--e-8);
  }
  .panneau__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-3);
  }
  .panneau__liste a {
    text-decoration: none;
  }
  .panneau__liste--secondaire {
    padding-top: var(--e-4);
    border-top: 1px solid var(--trait);
  }

  @media (max-width: 900px) {
    .barre__liens,
    .barre__telecharger {
      display: none;
    }
    .barre__menu {
      display: inline-block;
    }
  }
  @media (min-width: 901px) {
    #panneau-mobile {
      display: none !important;
    }
  }
</style>
