---
// La page d'accueil, dans une langue donnée. Le rythme d'apple.com : les
// sections alternent noir et clair, et chacune ne dit qu'une chose.
import Base from '../layouts/Base.astro';
import Navigation from './Navigation.astro';
import Hero from './Hero.astro';
import Galerie from './Galerie.astro';
import Zoom from './Zoom.astro';
import Manifeste from './Manifeste.astro';
import Parcours from './Parcours.astro';
import Fonctions from './Fonctions.astro';
import Confidentialite from './Confidentialite.astro';
import Usages from './Usages.astro';
import Questions from './Questions.astro';
import Famille from '../famille/Famille.astro';
import { famille } from '../famille/textes';
import { LIEN_ANDROID } from '../config';
import Fin from './Fin.astro';
import Pied from './Pied.astro';
import { BASE, chemin, textes, type Langue } from '../i18n';

interface Props { langue: Langue }
const { langue } = Astro.props;
const t = textes(langue);
const f = famille[langue];
// Les liens de la famille, vus depuis dropletmesh.app.
const liensFamille = {
  droplet: { href: LIEN_ANDROID, texte: f.telechargerAndroid, principal: true },
  web: { href: 'https://web.dropletmesh.app', texte: f.ouvrirWeb, principal: true },
  drop: { href: langue === 'fr' ? 'https://drop.dropletmesh.app/' : `https://drop.dropletmesh.app/${langue}/`, texte: `${f.decouvrir} Droplet Drop` },
};
---
<Base langue={langue}>
  <Navigation t={t} accueil={chemin(langue)} />
  <main>
    <Hero t={t} />
    <Galerie t={t} />
    <Zoom t={t} />
    <Manifeste t={t} langue={langue} />
    <Parcours t={t} />
    <Fonctions t={t} />
    <Confidentialite t={t} />
    <Usages t={t} />
    <Famille langue={langue} ici="droplet" liens={liensFamille} iconeDrop={`${BASE}/famille-drop.webp`} racine={BASE} />
    <Questions t={t} />
  </main>
  <Fin t={t} langue={langue} />
  <Pied t={t} langue={langue} />
</Base>
