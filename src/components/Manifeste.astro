---
// Le texte qui s'allume en défilant — la phrase d'Apple qui passe du gris
// au blanc, mot après mot, au rythme de la lecture. On ne peut pas la
// survoler : elle se lit à la vitesse où on la découvre.
import type { Textes, } from '../i18n/fr';
interface Props { t: Textes; langue: string }
const { t, langue } = Astro.props;
// En chinois, pas d'espaces : on découpe caractère par caractère.
const morceaux = langue === 'zh' ? [...t.manifeste] : t.manifeste.split(/(\s+)/);
---
<section class="manifeste fond-noir" data-manifeste>
  <p class="manifeste__texte contenu" aria-label={t.manifeste}>
    {morceaux.map((m) => (/^\s+$/.test(m) ? m : <span aria-hidden="true">{m}</span>))}
  </p>
</section>

<style>
  .manifeste {
    padding: clamp(80px, 14vw, 200px) 0;
  }
  .manifeste__texte {
    font-family: var(--f-titre);
    font-size: var(--t-4);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .manifeste__texte span {
    color: #333336;
    transition: color 0.35s var(--ease);
  }
  .manifeste__texte span.est-lu {
    color: var(--clair);
  }
  @media (prefers-reduced-motion: reduce) {
    .manifeste__texte span {
      color: var(--clair);
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-manifeste]');
  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const mots = [...section.querySelectorAll<HTMLElement>('span')];
    let attente = false;
    const maj = () => {
      attente = false;
      const texte = section.querySelector('p')!.getBoundingClientRect();
      const h = window.innerHeight;
      // Commence quand le haut du texte entre par le bas de l'écran, finit
      // quand son bas atteint le milieu : on lit au rythme où il s'allume.
      const p = Math.min(1, Math.max(0, (h * 0.88 - texte.top) / (h * 0.88 - h * 0.5 + texte.height)));
      const n = Math.round(p * mots.length);
      mots.forEach((m, i) => m.classList.toggle('est-lu', i < n));
    };
    maj();
    window.addEventListener(
      'scroll',
      () => {
        if (!attente) {
          attente = true;
          requestAnimationFrame(maj);
        }
      },
      { passive: true },
    );
  }
</script>
