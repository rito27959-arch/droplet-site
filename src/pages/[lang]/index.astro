---
// Une page par langue : /en/, /de/, /ar/… Le français est à la racine.
import Accueil from '../../components/Accueil.astro';
import { LANGUES, LANGUE_PAR_DEFAUT, type Langue } from '../../i18n';

export function getStaticPaths() {
  return LANGUES.filter((l) => l.code !== LANGUE_PAR_DEFAUT).map((l) => ({
    params: { lang: l.code },
  }));
}
const langue = Astro.params.lang as Langue;
---
<Accueil langue={langue} />
