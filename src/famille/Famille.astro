  }
  .anneau__plein {
    stroke: var(--cyan);
    stroke-linecap: round;
    stroke-dasharray: 315;
    stroke-dashoffset: 315;
  }
  .anneau__coche {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    transform: rotate(90deg);
    transform-origin: 60px 60px;
  }
  /* Quand la scène apparaît, l'anneau se remplit puis la coche se dessine. */
  .scene--drop.est-actif .anneau__plein {
    animation: anneau 1.6s 0.4s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  .scene--drop.est-actif .anneau__coche {
    animation: coche 0.5s 2s ease-out forwards;
  }
  @keyframes anneau {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes coche {
    to {
      stroke-dashoffset: 0;
    }
  }
  .p-vignettes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4em;
    width: 100%;
  }
  .p-vignettes span {
