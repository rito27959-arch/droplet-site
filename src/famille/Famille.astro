  }

  /* ── Sous la scène : la phrase et l'action ─────────────────────── */
  .famille__infos {
    display: grid;
    width: min(100% - 40px, 980px);
    margin: clamp(28px, 4vw, 48px) auto 0;
    text-align: start;
  }
  .info {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 24px clamp(28px, 6vw, 80px);
    align-items: start;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.4s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s 0.4s;
  }
  .info.est-actif {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.5s 0.15s ease,
      transform 0.7s 0.15s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s;
  }
  .info__texte {
    margin: 0;
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.3125rem);
    line-height: 1.42;
    color: #a1a1a6;
  }
  .info__texte strong {
    color: #f5f5f7;
    font-weight: 600;
  }
  .info__action {
    display: grid;
    justify-items: start;
    gap: 14px;
  }
  .info__plateformes {
    margin: 0;
    font-size: 0.875rem;
    color: #86868b;
  }
  .famille__bouton {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 980px;
