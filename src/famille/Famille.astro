    font-weight: 500;
    text-decoration: none;
    transition: filter 0.2s;
  }
  .famille__bouton:hover {
    filter: brightness(1.08);
  }
  .famille__lien {
    color: #2997ff;
    text-decoration: none;
  }
  .famille__lien::after {
    content: ' ›';
  }
  .famille__lien:hover {
    text-decoration: underline;
  }

  /* ── Téléphone : une scène plus haute, les appareils plus grands ── */
  @container (max-width: 640px) {
    .scene {
      --u: 1.55cqw;
    }
    .voisin,
    .relais {
      display: none;
    }
    .w-corps {
      grid-template-columns: 1fr;
    }
    .w-liste {
      display: none;
    }
    .fenetre {
      width: 96cqw;
      height: calc(var(--u) * 74);
      top: 0;
      font-size: calc(var(--u) * 1.55);
    }
    .tel__ecran {
      font-size: calc(var(--u) * 1.5);
    }
    .fenetre--drop {
      left: 0;
      width: 70cqw;
      height: calc(var(--u) * 70);
      font-size: calc(var(--u) * 1.2);
