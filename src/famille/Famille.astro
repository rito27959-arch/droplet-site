  .p-section {
    margin: 0.8em 0 0;
    font-weight: 650;
  }
  .p-appareil {
    display: flex;
    align-items: center;
    gap: 0.8em;
    padding: 0.7em 0.9em;
    border-radius: 1em;
    background: #141b28;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .p-appareil i {
    width: 2em;
    height: 2em;
    border-radius: 50%;
    background: linear-gradient(160deg, #4da8ff, #168bff);
  }
  .p-appareil .p-i2 {
    background: linear-gradient(160deg, #8c95ff, #4855e8);
  }
  .p-appareil .p-i3 {
    background: linear-gradient(160deg, #5ce1e6, #12b8e0);
  }
  .p-appareil b {
    font-weight: 600;
  }
  .tel--drop {
    right: 6%;
    top: 3%;
    width: calc(var(--u) * 26);
  }
  .ecran-drop {
    align-items: center;
    justify-content: center;
    gap: 1.2em;
    padding: 1.4em;
    background:
      radial-gradient(120% 60% at 0% 0%, rgba(22, 139, 255, 0.18), transparent 60%),
      #080c16;
    color: #f7f9fc;
    text-align: center;
  }
  .ecran-drop p {
    margin: 0;
