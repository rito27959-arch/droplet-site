---
// LA FAMILLE DROPLET — les trois apps, présentées par leur film : une
// vidéo comme celles des lancements d'Apple et d'Anthropic, puis les trois
// apps côte à côte, chacune avec sa phrase et son lien.
//
//   • Le film part tout seul, sans le son, quand la section arrive à
//     l'écran, et s'arrête quand elle en sort. Deux boutons ronds : lecture
//     / pause, et le son. « Réduire les animations » : jamais de lecture
//     automatique — on voit l'affiche, et on lance si on veut.
//   • Paysage 16:9 sur grand écran, vertical 9:16 sur téléphone : le
//     navigateur ne télécharge QUE la version qu'il montre.
//   • Les images du film sont les vraies apps (captures de la CI de Droplet
//     Drop, Droplet Web), ses phrases sont celles de textes.ts.
//
// ⚠️ CE COMPOSANT EST LE MÊME SUR LES DEUX SITES (src/famille/) ; seuls les
// liens, passés en propriétés, changent.
import { famille, type LangueFamille } from './textes';

interface Lien { href: string; texte: string; principal?: boolean }
interface Props {
  langue: LangueFamille;
  /** L'app du site qui affiche la section : elle est marquée « Vous êtes ici ». */
  ici: 'droplet' | 'web' | 'drop';
  liens: { droplet: Lien; web: Lien; drop: Lien };
  /** L'icône de Droplet Drop (image), relative à la racine du site. */
  iconeDrop: string;
  /** La racine du site (BASE), pour les fichiers du film. */
  racine?: string;
}
const { langue, ici, liens, iconeDrop, racine = '' } = Astro.props;
const t = famille[langue];
const film = (format: '16x9' | '9x16', ext: 'mp4' | 'webp') => `${racine}/video/droplet-famille-${format}.${ext}`;

const apps = [
  { cle: 'droplet', nom: 'Droplet', accroche: t.dropletAccroche, texte: t.dropletTexte, plateformes: t.dropletPlateformes },
  { cle: 'web', nom: 'Droplet Web', accroche: t.webAccroche, texte: t.webTexte, plateformes: t.webPlateformes },
  { cle: 'drop', nom: 'Droplet Drop', accroche: t.dropAccroche, texte: t.dropTexte, plateformes: t.dropPlateformes },
] as const;

// Le tracé de Droplet : la bulle et sa goutte (le même que Logo.astro).
const BULLE = 'M26.16 48.79A20 20 0 1 0 15.68 40L12.5 52.5Z';
const GOUTTE = 'M33 17.5C37.2 23 41.3 27 41.3 32.4a8.3 8.3 0 0 1-16.6 0C24.7 27 28.8 23 33 17.5Z';
---
<section id="famille" class="famille" data-famille aria-labelledby="famille-titre">
  <div class="famille__tete">
    <h2 id="famille-titre" class="famille__titre">{t.titre}</h2>
    <p class="famille__chapo">{t.chapo}</p>
  </div>

  <figure class="film">
    <div class="film__cadre">
      <video
        class="film__video"
        data-film
        muted
        playsinline
        loop
        preload="none"
        poster={film('16x9', 'webp')}
        data-h={film('16x9', 'mp4')}
        data-v={film('9x16', 'mp4')}
        data-affiche-h={film('16x9', 'webp')}
        data-affiche-v={film('9x16', 'webp')}
        aria-label={t.video}
      >
        <source src={film('16x9', 'mp4')} type="video/mp4" />
      </video>
      <div class="film__commandes">
        <button class="rond" type="button" data-lecture aria-label={t.lecture} data-texte-lecture={t.lecture} data-texte-pause={t.pause}>
          <svg viewBox="0 0 24 24" class="pause" aria-hidden="true"><rect x="7" y="5.5" width="3.4" height="13" rx="1.2" /><rect x="13.6" y="5.5" width="3.4" height="13" rx="1.2" /></svg>
          <svg viewBox="0 0 24 24" class="lecture" aria-hidden="true"><path d="M8 5.8v12.4a1 1 0 0 0 1.5.86l10-6.2a1 1 0 0 0 0-1.72l-10-6.2A1 1 0 0 0 8 5.8z" /></svg>
        </button>
        <button class="rond" type="button" data-son aria-label={t.son} data-texte-son={t.son} data-texte-muet={t.sansSon}>
          <svg viewBox="0 0 24 24" class="muet" aria-hidden="true"><path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" /><path d="M16 9.5l5 5m0-5l-5 5" class="trait" /></svg>
          <svg viewBox="0 0 24 24" class="sonore" aria-hidden="true"><path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" /><path d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a7.8 7.8 0 0 1 0 11" class="trait" /></svg>
        </button>
      </div>
    </div>
    {t.videoLangue && <figcaption class="film__langue">{t.videoLangue}</figcaption>}
  </figure>

  <ul class="famille__apps">
    {apps.map((a) => (
      <li class:list={['app', `app--${a.cle}`, { 'est-ici': a.cle === ici }]}>
        <span class:list={['icone', `icone--${a.cle}`]} aria-hidden="true">
          {a.cle === 'drop' ? (
            <img src={iconeDrop} width="64" height="64" alt="" />
          ) : (
            <svg viewBox="0 0 64 64">
              <path d={BULLE} class="icone__bulle" />
              <path d={GOUTTE} class="icone__goutte" />
              {a.cle === 'web' && <rect x="9" y="9" width="46" height="46" rx="9" class="icone__cadre" />}
            </svg>
          )}
        </span>
        <h3 class="app__nom">{a.nom}{a.cle === ici && <span class="app__ici">{t.ici}</span>}</h3>
        <p class="app__texte"><strong>{a.accroche}</strong> {a.texte}</p>
        <p class="app__plateformes">{a.plateformes}</p>
        <a class:list={[liens[a.cle].principal ? 'famille__bouton' : 'famille__lien']} href={liens[a.cle].href}>{liens[a.cle].texte}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .famille {
    --rose: #ff2d55;
    position: relative;
    padding: clamp(96px, 12vw, 160px) 0 clamp(88px, 11vw, 140px);
    overflow: hidden;
    color: #f5f5f7;
    text-align: center;
    background:
      radial-gradient(50% 36% at 50% 46%, color-mix(in srgb, var(--rose) 18%, transparent), transparent 72%),
      #05070c;
  }
  .famille__tete {
    width: min(100% - 40px, 820px);
    margin-inline: auto;
  }
  .famille__titre {
    font-size: clamp(2.6rem, 1.2rem + 4.6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.026em;
    font-weight: 650;
  }
  .famille__chapo {
    margin: 18px auto 0;
    max-width: 34rem;
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.3125rem);
    line-height: 1.4;
    color: #a1a1a6;
  }

  /* ── Le film ───────────────────────────────────────────────────── */
  .film {
    width: min(100% - 40px, 1180px);
    margin: clamp(44px, 6vw, 72px) auto 0;
  }
  .film__cadre {
    position: relative;
    border-radius: clamp(18px, 2.4vw, 30px);
    overflow: hidden;
    background: #000;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 40px 120px rgba(0, 0, 0, 0.55);
    aspect-ratio: 16 / 9;
  }
  .film__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film__commandes {
    position: absolute;
    inset-inline-end: clamp(12px, 1.6vw, 20px);
    bottom: clamp(12px, 1.6vw, 20px);
    display: flex;
    gap: 10px;
  }
  .rond {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #f5f5f7;
    background: rgba(40, 40, 46, 0.62);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    backdrop-filter: blur(18px) saturate(1.6);
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.18);
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s;
  }
  .rond:hover { background: rgba(60, 60, 68, 0.72); }
  .rond:active { transform: scale(0.92); }
  .rond:focus-visible { outline: 2px solid #2997ff; outline-offset: 3px; }
  .rond svg { width: 22px; height: 22px; fill: currentColor; }
  .rond .trait { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .film .lecture, .film .sonore { display: none; }
  .film.est-en-pause .pause { display: none; }
  .film.est-en-pause .lecture { display: block; }
  .film.avec-son .muet { display: none; }
  .film.avec-son .sonore { display: block; }
  .film__langue {
    margin-top: 12px;
    font-size: 0.875rem;
    color: #86868b;
  }
  /* Sur téléphone : le film vertical, à la largeur de l'écran. */
  @media (max-width: 640px) {
    .film { width: min(100% - 32px, 440px); }
    .film__cadre { aspect-ratio: 9 / 16; }
  }

  /* ── Les trois apps ────────────────────────────────────────────── */
  .famille__apps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
    width: min(100% - 40px, 1180px);
    margin: clamp(56px, 7vw, 88px) auto 0;
    padding: 0;
    text-align: start;
  }
  @media (max-width: 860px) {
    .famille__apps { grid-template-columns: 1fr; max-width: 560px; }
  }
  .app {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .icone {
    display: grid;
    place-items: center;
    width: 56px;
    aspect-ratio: 1;
    border-radius: 23.5%;
    overflow: hidden;
    margin-bottom: 18px;
  }
  .icone img,
  .icone svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Droplet : la bulle blanche sur le rose. */
  .icone--droplet {
    background: linear-gradient(160deg, #ff5a7a, #ff2d55 55%, #e0123d);
  }
  .icone--droplet .icone__bulle,
  .icone--web .icone__bulle {
    fill: none;
    stroke: #fff;
    stroke-width: 5.2;
    stroke-linejoin: round;
    transform: scale(0.72);
    transform-origin: 50% 50%;
  }
  .icone--droplet .icone__goutte,
  .icone--web .icone__goutte {
    fill: #fff;
    transform: scale(0.72);
    transform-origin: 50% 50%;
  }
  /* Droplet Web : la même bulle, en rose sur la nuit, dans un écran. */
  .icone--web {
    background: linear-gradient(160deg, #2a2a30, #121216);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .icone--web .icone__bulle {
    stroke: var(--rose);
    transform: scale(0.56);
  }
  .icone--web .icone__goutte {
    fill: var(--rose);
    transform: scale(0.56);
  }
  .icone__cadre {
    fill: none;
    stroke: rgba(255, 255, 255, 0.35);
    stroke-width: 2;
  }
  .app__nom {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .app__ici {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 999px;
    color: #f5f5f7;
    background: rgba(255, 255, 255, 0.12);
    letter-spacing: 0;
  }
  .app__texte {
    margin-top: 10px;
    font-size: 1.0625rem;
    line-height: 1.47;
    color: #a1a1a6;
  }
  .app__texte strong { color: #f5f5f7; font-weight: 600; }
  .app__plateformes {
    margin-top: 12px;
    font-size: 0.9375rem;
    color: #86868b;
  }
  .famille__bouton, .famille__lien {
    margin-top: auto;
    padding-top: 18px;
  }
  .famille__bouton {
    display: inline-block;
    margin-top: 22px;
    padding: 11px 22px;
    border-radius: 999px;
    color: #fff;
    background: #0071e3;
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s;
  }
  .famille__bouton:hover { background: #0077ed; }
  .famille__lien {
    margin-top: 22px;
    padding-top: 0;
    color: #2997ff;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .famille__lien::after { content: ' ›'; }
  .famille__lien:hover { text-decoration: underline; }
  .famille__bouton:focus-visible, .famille__lien:focus-visible { outline: 2px solid #2997ff; outline-offset: 3px; }
</style>

<script>
  // Le film : la bonne version pour l'écran, lecture quand il est visible,
  // pause et son à la main.
  document.querySelectorAll<HTMLElement>('[data-famille]').forEach((section) => {
    const video = section.querySelector<HTMLVideoElement>('[data-film]');
    const figure = section.querySelector<HTMLElement>('.film');
    const lecture = section.querySelector<HTMLButtonElement>('[data-lecture]');
    const son = section.querySelector<HTMLButtonElement>('[data-son]');
    if (!video || !figure || !lecture || !son) return;
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const etroit = window.matchMedia('(max-width: 640px)');
    let voulu = !reduit; // l'utilisateur veut-il que le film tourne ?

    // Une seule version téléchargée : celle que l'écran montre.
    const choisir = () => {
      const v = etroit.matches;
      const src = v ? video.dataset.v! : video.dataset.h!;
      if (video.currentSrc.endsWith(src) || video.getAttribute('src') === src) return;
      const enCours = !video.paused;
      video.poster = v ? video.dataset.afficheV! : video.dataset.afficheH!;
      video.innerHTML = '';
      video.src = src;
      if (enCours) video.play().catch(() => {});
    };
    choisir();
    etroit.addEventListener('change', choisir);

    const etat = () => {
      figure.classList.toggle('est-en-pause', video.paused);
      lecture.setAttribute('aria-label', video.paused ? lecture.dataset.texteLecture! : lecture.dataset.textePause!);
      figure.classList.toggle('avec-son', !video.muted);
      son.setAttribute('aria-label', video.muted ? son.dataset.texteSon! : son.dataset.texteMuet!);
    };
    video.addEventListener('play', etat);
    video.addEventListener('pause', etat);
    video.addEventListener('volumechange', etat);
    etat();

    lecture.addEventListener('click', () => {
      voulu = video.paused;
      if (voulu) video.play().catch(() => {});
      else video.pause();
    });
    son.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted && video.paused) {
        voulu = true;
        video.play().catch(() => {});
      }
    });
    // Un clic sur le film : lecture ou pause, comme le bouton.
    video.addEventListener('click', () => lecture.click());

    // À l'écran : lecture (si voulue) ; hors de l'écran : pause.
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && voulu) video.play().catch(() => {});
        else if (!e.isIntersecting && !video.paused) video.pause();
      },
      { threshold: 0.45 },
    ).observe(video);
  });
</script>
