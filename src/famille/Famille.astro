      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene,
    .info {
      transition: none;
    }
    .relais path {
      animation: none;
    }
    .anneau__plein,
    .anneau__coche {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // Les onglets : clic, clavier (flèches, Début, Fin), et lecture
  // automatique pilotée par la barre de progression.
  document.querySelectorAll<HTMLElement>('[data-famille]').forEach((section) => {
    const onglets = [...section.querySelectorAll<HTMLButtonElement>('[data-onglet]')];
    const scenes = [...section.querySelectorAll<HTMLElement>('[data-scene]')];
    const infos = [...section.querySelectorAll<HTMLElement>('[data-info]')];
    const bouton = section.querySelector<HTMLButtonElement>('[data-lecture]')!;
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actif = Math.max(0, onglets.findIndex((o) => o.classList.contains('est-actif')));

    const montrer = (i: number, focus = false) => {
      actif = (i + onglets.length) % onglets.length;
      const cle = onglets[actif].dataset.onglet!;
      section.dataset.actif = cle;
      onglets.forEach((o, k) => {
        const oui = k === actif;
        o.classList.toggle('est-actif', oui);
        o.setAttribute('aria-selected', String(oui));
        o.tabIndex = oui ? 0 : -1;
      });
      scenes.forEach((s) => s.classList.toggle('est-actif', s.dataset.scene === cle));
      infos.forEach((s) => s.classList.toggle('est-actif', s.dataset.info === cle));
      if (focus) onglets[actif].focus();
    };

    const lecture = (oui: boolean) => {
      section.classList.toggle('est-en-lecture', oui);
      bouton.setAttribute('aria-label', oui ? bouton.dataset.textePause! : bouton.dataset.texteLecture!);
    };

    // La fin du remplissage de la barre : app suivante.
    section.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName.includes('remplir') && section.classList.contains('est-en-lecture')) {
        montrer(actif + 1);
      }
    });

    onglets.forEach((o, i) => {
      o.addEventListener('click', () => {
        lecture(false);
        montrer(i);
      });
      o.addEventListener('keydown', (e) => {
        const rtl = getComputedStyle(section).direction === 'rtl';
        const pas = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 } as Record<string, number>;
        if (e.key in pas) {
          e.preventDefault();
          lecture(false);
          montrer(actif + pas[e.key], true);
        } else if (e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          lecture(false);
          montrer(e.key === 'Home' ? 0 : onglets.length - 1, true);
        }
      });
    });
    bouton.addEventListener('click', () => lecture(!section.classList.contains('est-en-lecture')));

    // La lecture ne tourne que si la section est à l'écran.
    if (!reduit) lecture(true);
    else lecture(false);
    new IntersectionObserver(([e]) => section.classList.toggle('est-suspendue', !e.isIntersecting), {
      threshold: 0.35,
    }).observe(section);
    section.classList.add('est-suspendue');
  });
</script>
