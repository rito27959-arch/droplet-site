  .p-tete {
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-size: 1.5em;
    letter-spacing: -0.02em;
  }
  .p-tete img {
    width: 1.9em;
    height: 1.9em;
    border-radius: 0.45em;
  }
  .p-envoyer,
  .p-recevoir {
    display: grid;
    place-items: center;
    height: 3.2em;
    border-radius: 1em;
    font-weight: 650;
  }
  .p-envoyer {
    margin-top: 0.6em;
    background: linear-gradient(135deg, var(--bleu), var(--cyan));
